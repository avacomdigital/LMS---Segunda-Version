<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pruebas de lo que las pantallas de acceso de OPS deciden sin interfaz (requisitos de acceso 2026-10-05, RF-01…RF-09): la regla local del PIN maestro,
    el código del aula, el borrador del primer arranque, la hoja de acceso, qué ofrece el acceso según el nodo y la banda del vencimiento. OPS es una app
    MAUI y no se puede referenciar desde aquí: se COMPILA su archivo (vínculo, no copia), que no usa nada de MAUI. Lo que se prueba es el código que corre
    en el equipo del aula.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Avacom.Lms.Ops.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Avacom.Lms.Core\Avacom.Lms.Core.csproj" />
  </ItemGroup>

  <!-- El código de OPS que se prueba, tal cual está en la app. -->
  <ItemGroup>
    <Compile Include="..\..\src\Avacom.Lms.Ops\Acceso\ReglasDeAcceso.cs" Link="Ops\Acceso\ReglasDeAcceso.cs" />
  </ItemGroup>

  <!-- MOD-011 · Calificaciones: la lógica pura de las pantallas (sin MAUI; las piezas con interfaz viven en Calificaciones\Ui y no entran aquí) y las respuestas REALES del backend que ya capturó Core, vinculadas y no copiadas. -->
  <ItemGroup>
    <Compile Include="..\..\src\Avacom.Lms.Ops\Calificaciones\*.cs" LinkBase="Ops\Calificaciones" />
    <None Include="..\Avacom.Lms.Core.Tests\Fixtures\gradebook\*.json" Link="Fixtures\gradebook\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- MOD-021 · Buscar: quién puede abrirla y adónde lleva cada resultado (sin MAUI; las piezas con interfaz viven en BusquedaUi.cs y no entran aquí). -->
  <ItemGroup>
    <Compile Include="..\..\src\Avacom.Lms.Ops\Busqueda\ReglasDeBusqueda.cs" Link="Ops\Busqueda\ReglasDeBusqueda.cs" />
  </ItemGroup>

  <!-- MOD-013 · Reportes: cómo se guarda un reporte exportado en una memoria USB, un disco externo o cualquier carpeta (destinos, unidades, vigilante, preferencias y escritura segura).
       Es lógica pura, sin MAUI: las piezas con interfaz viven en Reportes\Ui, que usa MAUI y NO entra aquí (el patrón no baja a subcarpetas y además se excluye por claridad). -->
  <ItemGroup>
    <Compile Include="..\..\src\Avacom.Lms.Ops\Reportes\*.cs" Exclude="..\..\src\Avacom.Lms.Ops\Reportes\Ui\**" LinkBase="Ops\Reportes" />
    <!-- Las respuestas REALES de /api/reportes/ que ya capturó Core (vinculadas, no copiadas): recientes, clases, alumnos… -->
    <None Include="..\Avacom.Lms.Core.Tests\Fixtures\reportes\*.json" Link="Fixtures\reportes\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- MOD-018 · Licencia: cómo se encuentran los .avlic en las memorias y carpetas, el flujo de tres pasos, la liberación, la copia de custodia y su escritura segura. Lógica pura, sin MAUI:
       las piezas con interfaz viven en Licencia\Ui y NO entran aquí. Las respuestas y los archivos REALES del backend que ya capturó Core, vinculados y no copiados. -->
  <ItemGroup>
    <Compile Include="..\..\src\Avacom.Lms.Ops\Licencia\*.cs" Exclude="..\..\src\Avacom.Lms.Ops\Licencia\Ui\**" LinkBase="Ops\Licencia" />
    <None Include="..\Avacom.Lms.Core.Tests\Fixtures\licencia\*.json;..\Avacom.Lms.Core.Tests\Fixtures\licencia\*.avlic;..\Avacom.Lms.Core.Tests\Fixtures\licencia\*.avreq;..\Avacom.Lms.Core.Tests\Fixtures\licencia\*.avrel"
          Link="Fixtures\licencia\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
