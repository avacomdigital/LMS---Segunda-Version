<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Avacom.Lms.Ops.Pages.ExamenExpedientePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ui="clr-namespace:Avacom.Lms.Ui.Controls;assembly=Avacom.Lms.Ui"
    BackgroundColor="#EAF0F6"
    Shell.NavBarIsVisible="False"
    SizeChanged="OnPageSizeChanged">
    <!-- Estructura del Aula · Design System: isla de marca, fecha y hora y fondo liso (evaluar); la raíz de la pantalla va debajo, sin cambios. -->
    <ui:MarcoDs Aurora="False">
    <!-- Expediente de un intento (MOD-010 · PAN-062). SOLO LECTURA mientras el alumno presenta: quién es, su tableta, su nivel, el cronómetro, qué pasó y a qué
         hora, y lo que informó su tableta del bloqueo. Cuando el intento ya se entregó, esta misma pantalla es el único lugar donde se revisan las respuestas, se
         publica la calificación y —como decisión humana, con motivo y con nombre— se anula. -->
    <Grid x:Name="Raiz">
        <Grid RowDefinitions="Auto,Auto,*" Padding="44,24,48,16" RowSpacing="12">
            <Grid x:Name="Cabecera" Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="24" HorizontalOptions="Center" WidthRequest="1280">
                <VerticalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                    <Label x:Name="SobreLabel" Text="EXPEDIENTE DEL INTENTO" FontFamily="Lexend" FontSize="12" TextColor="#4F5566" CharacterSpacing="2.5" />
                    <Label x:Name="TituloLabel" Text="Cargando…" FontFamily="LexendMedium" FontSize="30" TextColor="#1F2433" LineBreakMode="WordWrap" />
                    <Label x:Name="SubtituloLabel" Text="" FontFamily="Lexend" FontSize="15" TextColor="#4F5566" LineBreakMode="WordWrap" />
                    <FlexLayout x:Name="PastillasHost" Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Start" Margin="0,4,0,0" />
                </VerticalStackLayout>
                <HorizontalStackLayout x:Name="AccionesHost" Grid.Column="1" Spacing="12" VerticalOptions="Center" />
            </Grid>
            <VerticalStackLayout x:Name="AvisoHost" Grid.Row="1" HorizontalOptions="Center" WidthRequest="1280" Spacing="8" />
            <ScrollView x:Name="Desplazable" Grid.Row="2">
                <VerticalStackLayout x:Name="ContenidoHost" HorizontalOptions="Center" WidthRequest="1280" Spacing="14" Padding="0,0,0,40" />
            </ScrollView>
        </Grid>
    </Grid>
    </ui:MarcoDs>
</ContentPage>
