<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Avacom.Lms.Ops.Pages.EstudioPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ui="clr-namespace:Avacom.Lms.Ui.Controls;assembly=Avacom.Lms.Ui"
    BackgroundColor="#EAF0F6"
    Shell.NavBarIsVisible="False"
    SizeChanged="OnPageSizeChanged">
    <!-- Estructura del Aula · Design System: isla de marca, fecha y hora y fondo Aurora; la raíz de la pantalla va debajo, sin cambios. -->
    <ui:MarcoDs>
    <!-- Modo de estudio (MOD-008 · CAP-050/051). Una sola columna centrada, como «Dispositivos»: cabecera con el título y las acciones de la
         vista, un carril de avisos, el contenido que se desplaza y, sólo al asignar, un pie fijo con «Atrás» y «Siguiente». Las tres vistas
         (asignaciones, quién completó, asignar una lección) las pinta el código; todo se hace con toques: el nodo principal no tiene teclado. -->
    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="44,28,48,24" RowSpacing="16">
        <Grid x:Name="Cabecera" Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="24" HorizontalOptions="Center" WidthRequest="1280">
            <VerticalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                <Label x:Name="SobreLabel" Text="MODO DE ESTUDIO" FontFamily="Lexend" FontSize="12" TextColor="#4F5566" CharacterSpacing="2.5" />
                <Label x:Name="TituloLabel" Text="Lecciones para estudiar" FontFamily="LexendMedium" FontSize="30" TextColor="#1F2433" LineBreakMode="WordWrap" />
                <Label x:Name="SubtituloLabel" Text="" FontFamily="Lexend" FontSize="15" TextColor="#4F5566" LineBreakMode="WordWrap" />
            </VerticalStackLayout>
            <HorizontalStackLayout x:Name="AccionesHost" Grid.Column="1" Spacing="12" VerticalOptions="Center" />
        </Grid>
        <VerticalStackLayout x:Name="AvisoHost" Grid.Row="1" HorizontalOptions="Center" WidthRequest="1280" Spacing="10" />
        <ScrollView x:Name="Desplazable" Grid.Row="2">
            <VerticalStackLayout x:Name="ContenidoHost" HorizontalOptions="Center" WidthRequest="1280" Spacing="14" Padding="0,0,0,40" />
        </ScrollView>
        <Border x:Name="PieBarra" Grid.Row="3" IsVisible="False" HorizontalOptions="Center" WidthRequest="1280" Padding="18,10" BackgroundColor="#FFFFFF" Stroke="#E3E6EC" StrokeThickness="1" StrokeShape="RoundRectangle 22">
            <Border.Shadow><Shadow Brush="#1F2433" Opacity="0.08" Offset="0,4" Radius="16" /></Border.Shadow>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                <HorizontalStackLayout x:Name="PieAtras" Grid.Column="0" VerticalOptions="Center" />
                <Label x:Name="PieLabel" Grid.Column="1" FontFamily="Lexend" FontSize="15" TextColor="#4F5566" VerticalOptions="Center" HorizontalOptions="Center" LineBreakMode="WordWrap" />
                <HorizontalStackLayout x:Name="PieSiguiente" Grid.Column="2" VerticalOptions="Center" />
            </Grid>
        </Border>
    </Grid>
    </ui:MarcoDs>
</ContentPage>
