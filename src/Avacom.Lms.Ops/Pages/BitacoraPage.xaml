<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Avacom.Lms.Ops.Pages.BitacoraPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F1F1F1"
    Shell.NavBarIsVisible="False">
    <!-- Bitácora y logs (MOD-019 · Audit), ruta «logs-bitacora». Misma composición que Dispositivos: una columna centrada de 1280 con la
         cabecera (título, resumen y acciones), una fila de pestañas y debajo el contenido de la pestaña. Todo por toque: filtros con
         selectores y fechas, motivos de lista; no hay nada que escribir salvo la autorización de salida (PAN-241), que pide el documento y la
         clave de OTRA persona de administración. Ninguna fila tiene editar ni borrar: la bitácora sólo se agrega. -->
    <Grid RowDefinitions="Auto,Auto,*" Padding="44,28,48,24" RowSpacing="16">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="24" HorizontalOptions="Center" MaximumWidthRequest="1280" WidthRequest="1280">
            <VerticalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                <Label x:Name="EyebrowLabel" Text="BITÁCORA Y LOGS" FontFamily="InterRegular" FontSize="12" TextColor="#52525B" CharacterSpacing="2.5" />
                <Label x:Name="TituloLabel" Text="Bitácora de auditoría" FontFamily="InterMedium" FontSize="30" TextColor="#18181B" />
                <Label x:Name="SubtituloLabel" Text="Quién hizo qué, cuándo, sobre qué y con qué resultado. La bitácora sólo se agrega; nadie puede editarla." FontFamily="InterLight" FontSize="15" TextColor="#52525B" LineBreakMode="WordWrap" />
            </VerticalStackLayout>
            <HorizontalStackLayout x:Name="AccionesHost" Grid.Column="1" Spacing="12" VerticalOptions="Center" />
        </Grid>
        <HorizontalStackLayout x:Name="PestanasHost" Grid.Row="1" Spacing="10" HorizontalOptions="Center" />
        <ScrollView Grid.Row="2">
            <VerticalStackLayout x:Name="ContenidoHost" HorizontalOptions="Center" MaximumWidthRequest="1280" WidthRequest="1280" Spacing="12" Padding="0,0,0,40" />
        </ScrollView>
    </Grid>
</ContentPage>
