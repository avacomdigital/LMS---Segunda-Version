<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Avacom.Lms.Ops.Pages.LoginPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:Avacom.Lms.Ui.Controls;assembly=Avacom.Lms.Ui" xmlns:gfx="clr-namespace:Avacom.Lms.Ui.Graphics;assembly=Avacom.Lms.Ui" Shell.NavBarIsVisible="False">
    <!-- Composición sobre la cuadrícula de tercios: la tarjeta va centrada en la línea vertical del primer tercio
         (columna 1: de 1/6 a 1/2 del ancho, desplazada 50 px a la izquierda por decisión de diseño) y el lápiz 3D centrado
         en la línea de 5/6 (columna 3: de 2/3 al borde), cabiendo en el tercio central de alto. El saludo vertical ocupa
         el canal izquierdo (columna 0). En Y, tarjeta y lápiz van de 1/6 a 5/6. -->
    <Grid ColumnDefinitions="*,2*,*,2*" RowDefinitions="*,4*,*">
        <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FDECEC" Offset="0"/><GradientStop Color="#E6F6FC" Offset="0.42"/><GradientStop Color="#FEF9E6" Offset="0.78"/><GradientStop Color="#F5E8F1" Offset="1"/></LinearGradientBrush></Grid.Background>
        <!-- Fondo decorativo (capa más baja, bajo la tarjeta): retícula de hexágonos grandes con las puntas redondeadas, en un solo
             GraphicsView que se adapta solo al tamaño de la ventana. InputTransparent: es 100 % decorativa y nunca captura toques ni clics.
             La tinta translúcida (negro al 10 %) da sobre blanco el mismo gris de la referencia (#E6E6E6) y sobre el degradado
             sólo oscurece un poco el tono que ya hay, en vez de un gris opaco que se perdería en las zonas azul y rosa. -->
        <GraphicsView Grid.ColumnSpan="4" Grid.RowSpan="3" InputTransparent="True" HorizontalOptions="Fill" VerticalOptions="Fill">
            <GraphicsView.Drawable>
                <gfx:RoundedHexagonBackgroundDrawable HexagonWidth="240" CornerRadius="12" Gap="6" StrokeColor="#1A000000" StrokeWidth="1.25"/>
            </GraphicsView.Drawable>
        </GraphicsView>
        <!-- Saludo vertical del canal izquierdo: seis idiomas en mayúsculas que se turnan con fundido lento (CyclingLabel).
             Rotado -90° sobre su centro: la caja sin rotar mide 1200 px de ancho desde el borde izquierdo, así que su centro
             cae en x = 600 y TranslationX lo lleva a x = 80, donde lo sitúa la referencia; centrado en vertical en la pantalla.
             Inter Light en cursiva sintética: el kit no lleva Inter-LightItalic.ttf; si se añade a Resources/Fonts basta
             registrar el alias y cambiar FontFamily. CharacterSpacing: en Windows MAUI lo pasa a milésimas de em con un
             factor fijo (valor × 0,0624 × FontSize), así que 4,3 son ~24 px de aire entre letras a 90 px. -->
        <controls:CyclingLabel Grid.ColumnSpan="4" Grid.RowSpan="3" WidthRequest="1200" HorizontalOptions="Start" VerticalOptions="Center" HorizontalTextAlignment="Center" Rotation="-90" TranslationX="-520" InputTransparent="True" Words="BIENVENIDO|WELCOME|WILLKOMMEN|BENVINGUT|BENVENUTO|BEM-VINDO" FadeMilliseconds="1400" HoldMilliseconds="2000" FontFamily="InterLight" FontAttributes="Italic" FontSize="90" CharacterSpacing="4.3" LineBreakMode="NoWrap" TextColor="{StaticResource BrandRed}" TextTransform="Uppercase"/>
        <!-- Tarjeta de vidrio (liquid glass): deja ver el fondo desenfocado y teñido de blanco. El canto es un degradado de luz que
             entra por arriba a la izquierda, se apaga en los lados y vuelve a asomar abajo a la derecha, y una sombra amplia y suave
             la despega del fondo. Botones, tipografía y contenido siguen tal cual. -->
        <controls:GlassBorder Grid.Column="1" Grid.Row="1" Padding="0" HorizontalOptions="Fill" VerticalOptions="Fill" TranslationX="-50" StrokeShape="RoundRectangle 24" StrokeThickness="1.5" TintColor="White" TintOpacity="0.32" BlurRadius="8" Brightness="0.08" Saturation="1.2">
            <controls:GlassBorder.Stroke><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFFFFFFF" Offset="0"/><GradientStop Color="#8CFFFFFF" Offset="0.3"/><GradientStop Color="#4DFFFFFF" Offset="0.5"/><GradientStop Color="#80FFFFFF" Offset="0.7"/><GradientStop Color="#D9FFFFFF" Offset="1"/></LinearGradientBrush></controls:GlassBorder.Stroke>
            <controls:GlassBorder.Shadow><Shadow Brush="#000000" Opacity="0.12" Offset="0,20" Radius="48"/></controls:GlassBorder.Shadow>
            <Grid>
                <!-- Capas del material, bajo el contenido y sin captar toques: el canto interior (el vidrio es más luminoso junto
                     al borde) y el brillo del tercio superior, donde la luz se refleja en la superficie. -->
                <Border InputTransparent="True" BackgroundColor="Transparent" StrokeThickness="1" StrokeShape="RoundRectangle 22" Margin="2">
                    <Border.Stroke><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#8CFFFFFF" Offset="0"/><GradientStop Color="#14FFFFFF" Offset="0.5"/><GradientStop Color="#66FFFFFF" Offset="1"/></LinearGradientBrush></Border.Stroke>
                </Border>
                <Border InputTransparent="True" StrokeThickness="0" StrokeShape="Rectangle" VerticalOptions="Start" HeightRequest="180">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#4DFFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background>
                </Border>
                <Grid RowDefinitions="1*,2*">
                    <!-- Tercio superior de la tarjeta: identidad + mensaje. Se apoya sobre la línea divisoria. -->
                    <VerticalStackLayout Grid.Row="0" Padding="40,0,40,18" Spacing="8" VerticalOptions="End">
                        <!-- El SVG lleva aire dentro de su viewBox (≈6% a la izquierda, ≈24% abajo); el margen negativo alinea el dibujo con el texto -->
                        <Image Source="avacom_lms_kit_logo.png" Aspect="AspectFit" HeightRequest="100" HorizontalOptions="Start" Margin="-8,0,0,-18"/>
                        <Label Text="Nodo principal del aula" FontSize="22" FontAttributes="Bold"/>
                        <Label Text="Configura la conexión al servicio local. El estado siempre permanece visible para facilitar el soporte en la pantalla OPS." Style="{StaticResource Muted}" LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                    <!-- Dos tercios inferiores: acción. La línea divisoria cae exactamente a 1/3 de la altura de la tarjeta.
                         Van en un ScrollView: con el acceso real (documento y clave) la lista es más alta y, si una ventana baja o el
                         teclado en pantalla la dejan sin sitio, se desplaza en vez de cortarse. La composición de la tarjeta no cambia. -->
                    <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Padding="40,0,40,24" Spacing="14" VerticalOptions="Start">
                        <BoxView HeightRequest="1" Color="#14000000"/>
                        <VerticalStackLayout x:Name="DireccionGrupo" Spacing="14">
                            <Label Text="Dirección del servidor" FontSize="13" Margin="0,8,0,0"/>
                            <Entry x:Name="ServerEntry" Text="http://127.0.0.1:8000" Keyboard="Url"/>
                        </VerticalStackLayout>
                        <!-- Estado y mensajes del acceso (conexión, credenciales, sesión terminada): el texto dice lo que pasa; el color sólo acompaña. -->
                        <Border x:Name="StatusCard" BackgroundColor="{StaticResource ErrorSoft}" Padding="14" StrokeThickness="0"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><Label x:Name="StatusDot" Text="●" TextColor="{StaticResource BrandRed}" VerticalOptions="Start"/><Label x:Name="StatusLabel" Grid.Column="1" Text="Sin comprobar · modo demo disponible" LineBreakMode="WordWrap"/></Grid></Border>
                        <!-- Sólo cuando el nodo exige sesión (007-10, RF-05): documento y contraseña, el mismo acceso para profesorado, administración y técnico
                             (el nodo sabe quién es por la cuenta). Debajo, siempre a la vista, «Crear mi usuario» y «Olvidé mi contraseña». -->
                        <VerticalStackLayout x:Name="CredencialesGrupo" IsVisible="False" Spacing="8">
                            <VerticalStackLayout x:Name="CamposGrupo" Spacing="8">
                                <Label Text="Documento" FontSize="13" Margin="0,4,0,0"/>
                                <Entry x:Name="DocumentoEntry" Placeholder="Tu número de documento" ReturnType="Next" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" SemanticProperties.Description="Documento" Completed="OnDocumentoCompleted"/>
                                <Label Text="Contraseña" FontSize="13" Margin="0,6,0,0"/>
                                <Entry x:Name="ClaveEntry" Placeholder="Tu contraseña" IsPassword="True" ReturnType="Go" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" SemanticProperties.Description="Contraseña" Completed="OnEntrar"/>
                                <Border Style="{StaticResource NeuButtonShell}" BackgroundColor="{StaticResource BrandRed}" Margin="0,6,0,0">
                                    <Border.Shadow><Shadow Brush="#80C8222F" Offset="0,8" Radius="18"/></Border.Shadow>
                                    <Button x:Name="EntrarButton" Text="Entrar" Style="{StaticResource PrimaryButton}" CornerRadius="12" BorderWidth="0" Clicked="OnEntrar">
                                        <Button.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#F25055" Offset="0"/><GradientStop Color="#E5262B" Offset="0.55"/><GradientStop Color="#B81C21" Offset="1"/></LinearGradientBrush></Button.Background>
                                    </Button>
                                </Border>
                                <!-- RF-05 · RN-03: sin PIN maestro configurado no se ofrecen (y la nota dice qué sigue); con el PIN vencido siguen ahí y explican qué pasó. -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <Button x:Name="CrearUsuarioButton" Text="Crear mi usuario" BackgroundColor="#B3FFFFFF" TextColor="{StaticResource Ink}" BorderColor="#17000000" BorderWidth="1" CornerRadius="12" FontSize="14" HeightRequest="40" MinimumWidthRequest="110" Clicked="OnCrearMiUsuario"/>
                                    <Button x:Name="OlvideButton" Grid.Column="1" Text="Olvidé mi contraseña" BackgroundColor="#B3FFFFFF" TextColor="{StaticResource Ink}" BorderColor="#17000000" BorderWidth="1" CornerRadius="12" FontSize="14" HeightRequest="40" MinimumWidthRequest="110" Clicked="OnOlvideMiContrasena"/>
                                </Grid>
                                <Label x:Name="CuentaNotaLabel" IsVisible="False" Style="{StaticResource Muted}" FontSize="12" LineBreakMode="WordWrap"/>
                                <Button x:Name="CambiarServidorButton" Text="Cambiar la dirección del servidor" BackgroundColor="Transparent" TextColor="{StaticResource InkMuted}" FontSize="13" HeightRequest="40" Clicked="OnCambiarServidor"/>
                            </VerticalStackLayout>
                            <!-- La administración entra además con el PIN maestro: el nodo lo pide DESPUÉS de comprobar la contraseña. Teclado propio (RF-00a):
                                 el equipo del aula no tiene teclado y el PIN nunca pasa por el del sistema. -->
                            <VerticalStackLayout x:Name="PinGrupo" IsVisible="False" Spacing="10">
                                <Label Text="PIN maestro de la escuela" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                                <controls:TecladoPinView x:Name="PinTeclado" Longitud="6" Separacion="10" HorizontalOptions="Center" PinCompleto="OnPinMaestroCompleto"/>
                                <Button x:Name="PinVolverButton" Text="Volver" BackgroundColor="Transparent" TextColor="{StaticResource InkMuted}" FontSize="14" HeightRequest="40" MinimumWidthRequest="110" HorizontalOptions="Center" Clicked="OnPinVolver"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                        <VerticalStackLayout x:Name="AccionesGrupo" Spacing="14">
                            <Border Style="{StaticResource NeuButtonShell}" BackgroundColor="{StaticResource Ink}" Margin="0,4,0,0">
                                <Border.Shadow><Shadow Brush="#66000000" Offset="0,8" Radius="18"/></Border.Shadow>
                                <Button x:Name="CheckButton" Text="Comprobar conexión" Style="{StaticResource DarkButton}" CornerRadius="12" BorderWidth="0" Clicked="OnCheckConnection">
                                    <Button.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#3A3A40" Offset="0"/><GradientStop Color="#232326" Offset="0.55"/><GradientStop Color="#0E0E10" Offset="1"/></LinearGradientBrush></Button.Background>
                                </Button>
                            </Border>
                            <!-- RF-05: «Iniciar como profesor» sin credenciales sólo existe con el nodo en modo prototipo (no exige sesión). Nunca se simula un acceso. -->
                            <Border x:Name="IniciarCapsula" IsVisible="False" Style="{StaticResource NeuButtonShell}" BackgroundColor="{StaticResource BrandRed}" Margin="0,4,0,0">
                                <Border.Shadow><Shadow Brush="#80C8222F" Offset="0,8" Radius="18"/></Border.Shadow>
                                <Button x:Name="IniciarButton" Text="EC   Iniciar como profesor" Style="{StaticResource PrimaryButton}" CornerRadius="12" BorderWidth="0" Clicked="OnEnterDemo">
                                    <Button.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#F25055" Offset="0"/><GradientStop Color="#E5262B" Offset="0.55"/><GradientStop Color="#B81C21" Offset="1"/></LinearGradientBrush></Button.Background>
                                </Button>
                            </Border>
                            <Label x:Name="PrototipoNota" IsVisible="False" Text="Este nodo está en modo prototipo: se entra sin identificarse. Al conectarse, usa /health/ y los contratos REST/WebSocket definidos." Style="{StaticResource Muted}" HorizontalTextAlignment="Center" FontSize="11" LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </Grid>
        </controls:GlassBorder>
        <!-- Lápiz 3D decorativo (render nativo en un GraphicsView transparente): gira despacio sobre su eje vertical, inclinado
             8°, flotando apenas. Centrado en la línea de 5/6; con FillRatio 0,53 cabe en el tercio central de alto. Sólo se ve
             el lápiz; el fondo sigue debajo y la capa no captura toques. -->
        <controls:Pencil3DView Grid.Column="3" Grid.Row="1" InputTransparent="True" HorizontalOptions="Fill" VerticalOptions="Fill" SecondsPerTurn="12" TiltDegrees="8" FloatPixels="3" FillRatio="0.53"/>
    </Grid>
</ContentPage>
