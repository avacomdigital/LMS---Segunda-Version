<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Avacom.Lms.Ops.Pages.LoginPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:Avacom.Lms.Ui.Controls;assembly=Avacom.Lms.Ui" xmlns:gfx="clr-namespace:Avacom.Lms.Ui.Graphics;assembly=Avacom.Lms.Ui" Shell.NavBarIsVisible="False">
    <!-- Acceso de OPS con la estructura del Aula · Design System (pizarra 1920 × 1080): fondo Nube con hexágonos de marca (efecto
         de acceso y portadas), isla de marca neumórfica arriba al centro con el logo, fecha y hora en la esquina superior izquierda
         (sólo información) y, en el área segura, una caja blanca centrada con antetítulo, título y la acción. Un solo botón lleno. -->
    <Grid x:Name="AccesoEscena" RowDefinitions="128,*,48">
        <controls:FondoHexagonos Grid.RowSpan="3"/>
        <controls:IslaDeMarca Grid.Row="0"/>
        <controls:EsquinaFechaHora Grid.Row="0" Margin="64,24,0,0"/>
        <!-- Caja del DS: superficie blanca opaca, contorno completo en Linea, radio 32 y sombra difusa sh-2. -->
        <controls:GlassBorder x:Name="AccesoCaja" Grid.Row="1" Padding="0" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="640" StrokeShape="RoundRectangle 32" StrokeThickness="1" TintColor="White" TintOpacity="1" BlurRadius="0" Brightness="0" Saturation="1" Backdrop="False" Stroke="{StaticResource Linea}">
            <controls:GlassBorder.Shadow><Shadow Brush="{StaticResource Tinta}" Opacity="0.13" Offset="0,14" Radius="32"/></controls:GlassBorder.Shadow>
            <!-- Con el acceso real (documento y clave) la lista es más alta: si una ventana baja la deja sin sitio, se desplaza dentro de la caja. -->
            <ScrollView VerticalScrollBarVisibility="Never">
                <VerticalStackLayout x:Name="AccesoContenido" Padding="56,44,56,40" Spacing="16">
                    <VerticalStackLayout Spacing="8" Margin="0,0,0,12">
                        <Label Text="ACCESO" FontFamily="LexendSemiBold" FontSize="12" CharacterSpacing="1.9" TextColor="{StaticResource Tinta2}" HorizontalTextAlignment="Center"/>
                        <Label Text="Entra a tu aula" FontSize="36" FontFamily="LexendSemiBold" HorizontalTextAlignment="Center"/>
                        <Label Text="Conecta la pizarra con tu aula para empezar." FontSize="17" TextColor="{StaticResource Tinta2}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                        <VerticalStackLayout x:Name="DireccionGrupo" Spacing="14">
                            <Label Text="Dirección del aula" FontSize="16" FontFamily="LexendMedium" TextColor="{StaticResource Tinta2}"/>
                            <controls:CampoDs><Entry ClassId="neumo" VerticalOptions="Center" x:Name="ServerEntry" Text="http://127.0.0.1:8000" Keyboard="Url"/></controls:CampoDs>
                        </VerticalStackLayout>
                        <!-- Estado y mensajes del acceso (conexión, credenciales, sesión terminada): el texto dice lo que pasa; el color sólo acompaña. -->
                        <Border x:Name="StatusCard" BackgroundColor="{StaticResource ErrorSoft}" Padding="18,14" StrokeThickness="0" StrokeShape="RoundRectangle 16"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><Label x:Name="StatusDot" Text="●" TextColor="{StaticResource Rojo600}" VerticalOptions="Start"/><Label x:Name="StatusLabel" Grid.Column="1" Text="Sin comprobar · modo demo disponible" LineBreakMode="WordWrap"/></Grid></Border>
                        <!-- Sólo cuando el nodo exige sesión (007-10, RF-05): documento y contraseña, el mismo acceso para profesorado, administración y técnico
                             (el nodo sabe quién es por la cuenta). Debajo, siempre a la vista, «Crear mi usuario» y «Olvidé mi contraseña». -->
                        <VerticalStackLayout x:Name="CredencialesGrupo" IsVisible="False" Spacing="8">
                            <VerticalStackLayout x:Name="CamposGrupo" Spacing="8">
                                <Label Text="Documento" FontSize="16" FontFamily="LexendMedium" TextColor="{StaticResource Tinta2}" Margin="0,4,0,0"/>
                                <controls:CampoDs><Entry ClassId="neumo" VerticalOptions="Center" x:Name="DocumentoEntry" Placeholder="Tu número de documento" ReturnType="Next" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" SemanticProperties.Description="Documento" Completed="OnDocumentoCompleted"/></controls:CampoDs>
                                <Label Text="Contraseña" FontSize="16" FontFamily="LexendMedium" TextColor="{StaticResource Tinta2}" Margin="0,6,0,0"/>
                                <controls:CampoDs><Entry ClassId="neumo" VerticalOptions="Center" x:Name="ClaveEntry" Placeholder="Tu contraseña" IsPassword="True" ReturnType="Go" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" SemanticProperties.Description="Contraseña" Completed="OnEntrar"/></controls:CampoDs>
                                <Border Style="{StaticResource NeuButtonShell}" BackgroundColor="{StaticResource Principal}" Margin="0,6,0,0">
                                    <Border.Shadow><Shadow Brush="{StaticResource Principal}" Opacity="0.22" Offset="0,4" Radius="10"/></Border.Shadow>
                                    <Button x:Name="EntrarButton" Text="Entrar" Style="{StaticResource PrimaryButton}" BorderWidth="0" Clicked="OnEntrar">
                                    </Button>
                                </Border>
                                <!-- RF-05 · RN-03: sin PIN maestro configurado no se ofrecen (y la nota dice qué sigue); con el PIN vencido siguen ahí y explican qué pasó. -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <Button x:Name="CrearUsuarioButton" Text="Crear mi usuario" BackgroundColor="{StaticResource Superficie}" TextColor="{StaticResource Tinta}" BorderColor="{StaticResource Linea}" BorderWidth="2" CornerRadius="28" FontSize="16" HeightRequest="56" MinimumWidthRequest="110" Clicked="OnCrearMiUsuario"/>
                                    <Button x:Name="OlvideButton" Grid.Column="1" Text="Olvidé mi contraseña" BackgroundColor="{StaticResource Superficie}" TextColor="{StaticResource Tinta}" BorderColor="{StaticResource Linea}" BorderWidth="2" CornerRadius="28" FontSize="16" HeightRequest="56" MinimumWidthRequest="110" Clicked="OnOlvideMiContrasena"/>
                                </Grid>
                                <Label x:Name="CuentaNotaLabel" IsVisible="False" Style="{StaticResource Muted}" FontSize="12" LineBreakMode="WordWrap"/>
                                <Button x:Name="CambiarServidorButton" Text="Cambiar la dirección del aula" BackgroundColor="Transparent" TextColor="{StaticResource Azul700}" FontSize="16" HeightRequest="48" Clicked="OnCambiarServidor"/>
                            </VerticalStackLayout>
                            <!-- La administración entra además con el PIN maestro: el nodo lo pide DESPUÉS de comprobar la contraseña. Teclado propio (RF-00a):
                                 el equipo del aula no tiene teclado y el PIN nunca pasa por el del sistema. -->
                            <VerticalStackLayout x:Name="PinGrupo" IsVisible="False" Spacing="10">
                                <Label Text="PIN maestro de la escuela" FontSize="18" FontFamily="LexendSemiBold" HorizontalTextAlignment="Center"/>
                                <controls:TecladoPinView x:Name="PinTeclado" Longitud="6" Separacion="10" HorizontalOptions="Center" PinCompleto="OnPinMaestroCompleto"/>
                                <Button x:Name="PinVolverButton" Text="Volver" BackgroundColor="Transparent" TextColor="{StaticResource Azul700}" FontSize="16" HeightRequest="48" MinimumWidthRequest="110" HorizontalOptions="Center" Clicked="OnPinVolver"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                        <VerticalStackLayout x:Name="AccionesGrupo" Spacing="14">
                            <Border Style="{StaticResource NeuButtonShell}" BackgroundColor="{StaticResource Superficie}" Margin="0,4,0,0">
                                <Border.Shadow><Shadow Brush="Transparent" Opacity="0" Offset="0,0" Radius="0"/></Border.Shadow>
                                <Button x:Name="CheckButton" Text="Comprobar conexión" Style="{StaticResource DarkButton}" Clicked="OnCheckConnection"/>
                            </Border>
                            <!-- RF-05: «Iniciar como profesor» sin credenciales sólo existe con el nodo en modo prototipo (no exige sesión). Nunca se simula un acceso. -->
                            <Border x:Name="IniciarCapsula" IsVisible="False" Style="{StaticResource NeuButtonShell}" BackgroundColor="{StaticResource Principal}" Margin="0,4,0,0">
                                <Border.Shadow><Shadow Brush="{StaticResource Principal}" Opacity="0.22" Offset="0,4" Radius="10"/></Border.Shadow>
                                <Button x:Name="IniciarButton" Text="Entra como profesor" Style="{StaticResource PrimaryButton}" BorderWidth="0" Clicked="OnEnterDemo"/>
                            </Border>
                            <Label x:Name="PrototipoNota" IsVisible="False" Text="Modo de prueba: se entra sin identificarse." Style="{StaticResource Muted}" HorizontalTextAlignment="Center" FontSize="13" LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </controls:GlassBorder>
    </Grid>
</ContentPage>
