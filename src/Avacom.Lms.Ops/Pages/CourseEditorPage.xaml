<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Avacom.Lms.Ops.Pages.CourseEditorPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ui="clr-namespace:Avacom.Lms.Ui.Controls;assembly=Avacom.Lms.Ui" Shell.NavBarIsVisible="False">
    <!-- Estructura del Aula · Design System: isla de marca, fecha y hora y fondo Aurora; la raíz de la pantalla va debajo, sin cambios. -->
    <ui:MarcoDs>
    <Grid RowDefinitions="68,*">
        <Grid BackgroundColor="Transparent" Padding="48,0" ColumnDefinitions="Auto,*,Auto"><Button Text="←  Volver" BackgroundColor="#FFFFFF" TextColor="#1F2433" BorderColor="#E3E6EC" BorderWidth="2" CornerRadius="26" FontSize="17" FontFamily="LexendMedium" HeightRequest="52" Padding="20,0" VerticalOptions="Center" Clicked="OnBack"/><Label Grid.Column="1" Text="Crear curso" HorizontalOptions="Center" VerticalOptions="Center" FontSize="18" FontFamily="LexendSemiBold"/><Button Grid.Column="2" Text="Guardar curso" Style="{StaticResource PrimaryButton}" WidthRequest="200" Clicked="OnSave"/></Grid>
        <ScrollView Grid.Row="1"><VerticalStackLayout Padding="48,32,48,80" Spacing="22" MaximumWidthRequest="1050" HorizontalOptions="Center">
            <Label Text="Diseña una experiencia de aprendizaje" Style="{StaticResource PageTitle}"/><Label Text="Crea la estructura que recibirán los estudiantes. Puedes ajustar cada unidad, lección y actividad." Style="{StaticResource Muted}"/>
            <Border Padding="26"><VerticalStackLayout Spacing="14"><Label Text="Información general" FontSize="20" FontFamily="LexendSemiBold"/><Grid ColumnDefinitions="2*,*" ColumnSpacing="16"><VerticalStackLayout><Label Text="Nombre del curso"/><Entry x:Name="CourseName" Text="Álgebra Octavo B"/></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="Grado"/><Picker x:Name="GradePicker" Title="Selecciona" ItemsSource="{Binding Grades}" SelectedIndex="1" BackgroundColor="White" HeightRequest="52"/></VerticalStackLayout></Grid><Label Text="Descripción"/><Editor Text="Fundamentos de álgebra, ecuaciones lineales y aplicaciones para estudiantes de octavo." HeightRequest="90" BackgroundColor="#F6F7F9"/></VerticalStackLayout></Border>
            <Grid ColumnDefinitions="*,Auto"><Label Text="Estructura del curso" FontSize="20" FontFamily="LexendSemiBold" VerticalOptions="Center"/><Button Grid.Column="1" Text="+ Agregar unidad" Style="{StaticResource DarkButton}" Clicked="OnAddUnit"/></Grid>
            <VerticalStackLayout x:Name="UnitsContainer" Spacing="14">
                <Border Padding="22"><Grid ColumnDefinitions="48,*"><Border BackgroundColor="#FDE7E7" StrokeThickness="0" WidthRequest="38" HeightRequest="38"><Label Text="1" TextColor="{StaticResource Magenta700}" FontFamily="LexendSemiBold" HorizontalOptions="Center" VerticalOptions="Center"/></Border><VerticalStackLayout Grid.Column="1"><Label Text="Unidad 1 · Lenguaje algebraico" FontSize="18" FontFamily="LexendSemiBold"/><Label Text="Lección: Expresiones algebraicas"/><Label Text="• Variables y constantes  ·  • Construye una expresión" Style="{StaticResource Muted}"/></VerticalStackLayout></Grid></Border>
                <Border Padding="22"><Grid ColumnDefinitions="48,*"><Border BackgroundColor="#FFEDDF" StrokeThickness="0" WidthRequest="38" HeightRequest="38"><Label Text="2" TextColor="#9A3412" FontFamily="LexendSemiBold" HorizontalOptions="Center" VerticalOptions="Center"/></Border><VerticalStackLayout Grid.Column="1"><Label Text="Unidad 2 · Ecuaciones lineales" FontSize="18" FontFamily="LexendSemiBold"/><Label Text="Lección: Igualdades y equivalencias"/><Label Text="• La balanza algebraica  ·  • Resuelve paso a paso" Style="{StaticResource Muted}"/></VerticalStackLayout></Grid></Border>
                <Border Padding="22"><Grid ColumnDefinitions="48,*"><Border BackgroundColor="#E3F5FC" StrokeThickness="0" WidthRequest="38" HeightRequest="38"><Label Text="3" TextColor="{StaticResource BrandBlue}" FontFamily="LexendSemiBold" HorizontalOptions="Center" VerticalOptions="Center"/></Border><VerticalStackLayout Grid.Column="1"><Label Text="Unidad 3 · Aplicaciones y reto final" FontSize="18" FontFamily="LexendSemiBold"/><Label Text="Lección: Modelación y evaluación"/><Label Text="• Problemas de contexto  ·  • Quiz: Conociendo México (5 preguntas)" Style="{StaticResource Muted}"/></VerticalStackLayout></Grid></Border>
            </VerticalStackLayout>
        </VerticalStackLayout></ScrollView>
    </Grid>
    </ui:MarcoDs>
</ContentPage>
