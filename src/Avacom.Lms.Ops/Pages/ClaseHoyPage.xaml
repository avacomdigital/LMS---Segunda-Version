<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Avacom.Lms.Ops.Pages.ClaseHoyPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ui="clr-namespace:Avacom.Lms.Ui.Controls;assembly=Avacom.Lms.Ui"
    xmlns:gfx="clr-namespace:Avacom.Lms.Ui.Graphics;assembly=Avacom.Lms.Ui"
    BackgroundColor="#B5A6C5"
    Shell.NavBarIsVisible="False"
    SizeChanged="OnPageSizeChanged">
    <!-- P1 · Clase de hoy en Liquid Glass. Dos columnas y una sola fila: el menú vertical fijo a la izquierda
         (250 px; 224 en anchos intermedios; raíl de iconos por debajo de 1100, ver OnPageSizeChanged) y el
         contenido, que se desplaza en vertical, a la derecha. No hay barra horizontal superior: el chip de la
         fuente vive ahora arriba a la derecha del contenido y sigue siendo tocable (alterna Biblioteca ↔ ejemplo).
         Jerarquía del vidrio: panal (1) → menú (2) → tarjetas y avisos (3) → botones, chips y hexágonos (4). -->
    <Grid x:Name="Marco" ColumnDefinitions="250,*">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#A99ABD" Offset="0" />
                <GradientStop Color="#B5A6C5" Offset="0.55" />
                <GradientStop Color="#C2B3CF" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Nivel 1 · panal de hexágonos grandes con las puntas redondeadas, continuo por toda la pantalla y detrás
             de todo. InputTransparent: es 100 % decorativo y nunca captura toques ni desplazamiento. -->
        <GraphicsView Grid.ColumnSpan="2" HorizontalOptions="Fill" InputTransparent="True" VerticalOptions="Fill">
            <GraphicsView.Drawable>
                <gfx:RoundedHexagonBackgroundDrawable CornerRadius="14" Gap="6" HexagonWidth="250" Opacity="0.4" StrokeColor="#C9BDD5" StrokeWidth="1" />
            </GraphicsView.Drawable>
        </GraphicsView>

        <!-- Nivel 2 · menú lateral: una gran lámina de vidrio con las cuatro opciones apiladas desde abajo. -->
        <ui:LiquidGlassPanel x:Name="MenuPanel" Grid.Column="0" Margin="20,20,0,20" BlurRadius="14" ContentPadding="14,18" CornerRadius="28" ShadowOpacity="0.22" ShadowRadius="40" SheenHeight="220" TintOpacity="0.14">
            <ui:VerticalNavigation x:Name="Navegacion" Active="menu" CerrarSesionTapped="OnCerrarSesion" ConfiguracionTapped="OnConfiguracion" LeccionTapped="OnLeccion" MenuPrincipalTapped="OnVolver" />
        </ui:LiquidGlassPanel>

        <!-- Contenido principal, desplazable. Los tres hosts (AvisoHost, HexHost, ListaHost) son los mismos de siempre:
             el code-behind los llena con la clase abierta, los avisos, los hexágonos de materia y las secciones de cursos. -->
        <ScrollView x:Name="Contenido" Grid.Column="1">
            <VerticalStackLayout HorizontalOptions="Center" MaximumWidthRequest="1280" Padding="44,28,48,80" Spacing="26">
                <!-- Hero: saludo, título y descripción respiran sobre el fondo, sin tarjeta. A la derecha, el chip de la
                     fuente (arriba) y el libro de cristal (debajo, sólo decorativo). -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="28" RowDefinitions="Auto,*">
                    <VerticalStackLayout Grid.RowSpan="2" Spacing="8" VerticalOptions="Center">
                        <Label Style="{StaticResource GlassEyebrow}" Text="¡Hola!" />
                        <Label Style="{StaticResource GlassHero}" Text="¿Qué vas a dar hoy?">
                            <Label.Shadow><Shadow Brush="#3B1E5E" Opacity="0.3" Offset="0,2" Radius="12" /></Label.Shadow>
                        </Label>
                        <Label Style="{StaticResource GlassLead}" Text="Toca una materia para ver sus cursos y elige la lección con la que empieza la clase. El curso lo entrega AVACOM Biblioteca; aquí sólo se da la clase." />
                        <Label x:Name="SubtituloLabel" Margin="0,6,0,0" Style="{StaticResource GlassCaption}" Text="Materias asignadas" />
                    </VerticalStackLayout>
                    <ui:SourceStatusChip x:Name="FuenteChip" Grid.Column="1" Grid.Row="0" HorizontalOptions="End" Text="Comprobando…" VerticalOptions="Start" />
                    <ui:GlassBookView Grid.Column="1" Grid.Row="1" Margin="0,8,0,0" HeightRequest="230" HorizontalOptions="End" InputTransparent="True" VerticalOptions="Center" WidthRequest="340" />
                </Grid>
                <VerticalStackLayout x:Name="AvisoHost" Spacing="12" />
                <FlexLayout x:Name="HexHost" AlignItems="Center" Direction="Row" JustifyContent="Start" Wrap="Wrap" />
                <VerticalStackLayout x:Name="ListaHost" Spacing="18" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
