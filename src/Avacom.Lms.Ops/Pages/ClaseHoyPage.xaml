<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Avacom.Lms.Ops.Pages.ClaseHoyPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ui="clr-namespace:Avacom.Lms.Ui.Controls;assembly=Avacom.Lms.Ui"
    BackgroundColor="#EAF0F6"
    Shell.NavBarIsVisible="False"
    SizeChanged="OnPageSizeChanged">
    <!-- P1 · Clase de hoy con la estructura del Aula · Design System: fondo Aurora, isla de marca y fecha y hora arriba (fijas),
         el contenido desplazable debajo y la navegación como barra inferior blanca, flotante y centrada (antes, menú lateral).
         La columna 0 se conserva a 0 de ancho porque el code-behind la sigue ajustando. -->
    <Grid x:Name="Marco" ColumnDefinitions="0,*" RowDefinitions="112,*">
        <ui:FondoAurora Grid.ColumnSpan="2" Grid.RowSpan="2" />
        <Grid Grid.Column="1" Grid.Row="0" ZIndex="3">
            <ui:IslaDeMarca />
            <ui:EsquinaFechaHora Margin="44,20,0,0" />
        </Grid>

        <!-- Barra inferior: las cuatro opciones de siempre (Menú principal, Lección, Configuración y Cerrar sesión). -->
        <Border x:Name="MenuPanel" Grid.Column="1" Grid.RowSpan="2" Margin="0,0,0,28" Padding="8,4" BackgroundColor="White" Stroke="#E3E6EC" StrokeThickness="1" StrokeShape="RoundRectangle 38" HeightRequest="76" HorizontalOptions="Center" VerticalOptions="End" ZIndex="5">
            <Border.Shadow><Shadow Brush="#1F2433" Opacity="0.13" Offset="0,14" Radius="32" /></Border.Shadow>
            <ui:VerticalNavigation x:Name="Navegacion" Active="menu" CerrarSesionTapped="OnCerrarSesion" ConfiguracionTapped="OnConfiguracion" LeccionTapped="OnLeccion" MenuPrincipalTapped="OnVolver" />
        </Border>

        <!-- Contenido principal, desplazable. Los tres hosts (AvisoHost, HexHost, ListaHost) son los mismos de siempre:
             el code-behind los llena con la clase abierta, los avisos, los hexágonos de materia y las secciones de cursos. -->
        <ScrollView x:Name="Contenido" Grid.Column="1" Grid.Row="1">
            <VerticalStackLayout HorizontalOptions="Center" MaximumWidthRequest="1280" Padding="64,8,64,140" Spacing="26">
                <!-- Hero: saludo, título y descripción respiran sobre el fondo, sin tarjeta. A la derecha, el chip de la
                     fuente (arriba) y el libro de cristal (debajo, sólo decorativo). -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="28" RowDefinitions="Auto,*">
                    <VerticalStackLayout Grid.RowSpan="2" Spacing="8" VerticalOptions="Center">
                        <Label Style="{StaticResource GlassEyebrow}" Text="¡Hola!" />
                        <Label Style="{StaticResource GlassHero}" Text="¿Qué vas a dar hoy?" />
                        <Label Style="{StaticResource GlassLead}" Text="Toca una materia para ver sus cursos y elige la lección con la que empieza la clase." />
                        <Label x:Name="SubtituloLabel" Margin="0,6,0,0" Style="{StaticResource GlassCaption}" Text="Materias asignadas" />
                    </VerticalStackLayout>
                    <ui:SourceStatusChip x:Name="FuenteChip" Grid.Column="1" Grid.Row="0" HorizontalOptions="End" Text="Comprobando…" VerticalOptions="Start" />
                    <!-- Ilustración con los iconos sólidos del Aula · Design System: las materias alrededor del libro (sólo decorativa). -->
                    <AbsoluteLayout Grid.Column="1" Grid.Row="1" Margin="0,8,0,0" HeightRequest="230" HorizontalOptions="End" InputTransparent="True" VerticalOptions="Center" WidthRequest="340">
                        <Image AbsoluteLayout.LayoutBounds="100,34,150,150" Source="ilus_libros.png" Aspect="AspectFit" />
                        <Image AbsoluteLayout.LayoutBounds="14,18,78,78" Source="ilus_mate.png" Aspect="AspectFit" Rotation="-8" />
                        <Image AbsoluteLayout.LayoutBounds="252,4,84,84" Source="ilus_ciencia.png" Aspect="AspectFit" Rotation="8" />
                        <Image AbsoluteLayout.LayoutBounds="30,140,68,68" Source="ilus_lenguaje.png" Aspect="AspectFit" Rotation="6" />
                        <Image AbsoluteLayout.LayoutBounds="262,140,70,70" Source="ilus_mundo.png" Aspect="AspectFit" Rotation="-6" />
                    </AbsoluteLayout>
                </Grid>
                <!-- Buscador y filtros del contenido que entrega AVACOM Biblioteca: texto libre (por él se buscan los temas,
                     demasiados para un picklist) y picklists de País y Nivel; bajo «Más filtros», Grado y Materia. Los
                     picklists los llena el code-behind con los valores distintos del catálogo y filtran hexágonos y
                     tarjetas al instante. -->
                <ui:SearchFilterBar x:Name="Buscador" />
                <VerticalStackLayout x:Name="AvisoHost" Spacing="12" />
                <FlexLayout x:Name="HexHost" AlignItems="Center" Direction="Row" JustifyContent="Start" Wrap="Wrap" />
                <VerticalStackLayout x:Name="ListaHost" Spacing="18" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
