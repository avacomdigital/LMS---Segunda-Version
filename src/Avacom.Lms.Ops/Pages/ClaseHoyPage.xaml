<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Avacom.Lms.Ops.Pages.ClaseHoyPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ui="clr-namespace:Avacom.Lms.Ui.Controls;assembly=Avacom.Lms.Ui"
    BackgroundColor="#F1F1F1"
    Shell.NavBarIsVisible="False"
    SizeChanged="OnPageSizeChanged">
    <!-- P1 · Clase de hoy. Dos columnas y una sola fila: el menú vertical fijo a la izquierda (250 px; 224 en anchos
         intermedios; raíl de iconos por debajo de 1100, ver OnPageSizeChanged) y el contenido, que se desplaza en
         vertical, a la derecha. No hay barra horizontal superior: el chip de la fuente vive arriba a la derecha del
         contenido y sigue siendo tocable (alterna Biblioteca ↔ ejemplo). Fondo claro como el resto de la aplicación
         (la imagen de discos en relieve), menú sólido del gris del dock y Liquid Glass sólo en tarjetas y avisos. -->
    <Grid x:Name="Marco" ColumnDefinitions="216,*">
        <!-- Fondo: la imagen de referencia de discos en relieve (assets/fondo-discos.png), a pantalla completa y detrás
             de todo, al 25 % sobre el gris #F1F1F1 de la página para que sólo insinúe el relieve. InputTransparent: es
             100 % decorativa y nunca captura toques ni desplazamiento. -->
        <Image Grid.ColumnSpan="2" Aspect="AspectFill" HorizontalOptions="Fill" InputTransparent="True" Opacity="0.25" Source="fondo_discos.png" VerticalOptions="Fill" />

        <!-- Menú lateral: barra sólida #5A5A56 (la del dock del tablero), estrecha (216 px), radio 28 y una sombra
             ligera y difusa que la despega del fondo, con las cuatro opciones apiladas desde abajo. -->
        <Border x:Name="MenuPanel" Grid.Column="0" Margin="20,20,0,20" Padding="12,16" BackgroundColor="#5A5A56" StrokeShape="RoundRectangle 28" StrokeThickness="0">
            <Border.Shadow><Shadow Brush="#000000" Opacity="0.16" Offset="0,10" Radius="28" /></Border.Shadow>
            <ui:VerticalNavigation x:Name="Navegacion" Active="menu" CerrarSesionTapped="OnCerrarSesion" ConfiguracionTapped="OnConfiguracion" LeccionTapped="OnLeccion" MenuPrincipalTapped="OnVolver" />
        </Border>

        <!-- Contenido principal, desplazable. Los tres hosts (AvisoHost, HexHost, ListaHost) son los mismos de siempre:
             el code-behind los llena con la clase abierta, los avisos, los hexágonos de materia y las secciones de cursos. -->
        <ScrollView x:Name="Contenido" Grid.Column="1">
            <VerticalStackLayout HorizontalOptions="Center" MaximumWidthRequest="1280" Padding="44,28,48,80" Spacing="26">
                <!-- Hero: saludo, título y descripción respiran sobre el fondo, sin tarjeta. A la derecha, el chip de la
                     fuente (arriba) y el libro de cristal (debajo, sólo decorativo). -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="28" RowDefinitions="Auto,*">
                    <VerticalStackLayout Grid.RowSpan="2" Spacing="8" VerticalOptions="Center">
                        <Label Style="{StaticResource GlassEyebrow}" Text="¡Hola!" />
                        <Label Style="{StaticResource GlassHero}" Text="¿Qué vas a dar hoy?" />
                        <Label Style="{StaticResource GlassLead}" Text="Toca una materia para ver sus cursos y elige la lección con la que empieza la clase. El curso lo entrega AVACOM Biblioteca; aquí sólo se da la clase." />
                        <Label x:Name="SubtituloLabel" Margin="0,6,0,0" Style="{StaticResource GlassCaption}" Text="Materias asignadas" />
                    </VerticalStackLayout>
                    <ui:SourceStatusChip x:Name="FuenteChip" Grid.Column="1" Grid.Row="0" HorizontalOptions="End" Text="Comprobando…" VerticalOptions="Start" />
                    <ui:GlassBookView Grid.Column="1" Grid.Row="1" Margin="0,8,0,0" HeightRequest="230" HorizontalOptions="End" InputTransparent="True" VerticalOptions="Center" WidthRequest="340" />
                </Grid>
                <!-- Buscador y filtros del contenido que entrega AVACOM Biblioteca: texto libre (por él se buscan los temas,
                     demasiados para un picklist) y picklists de País y Nivel; bajo «Más filtros», Grado y Materia. Los
                     picklists los llena el code-behind con los valores distintos del catálogo y filtran hexágonos y
                     tarjetas al instante. -->
                <ui:SearchFilterBar x:Name="Buscador" />
                <VerticalStackLayout x:Name="AvisoHost" Spacing="12" />
                <FlexLayout x:Name="HexHost" AlignItems="Center" Direction="Row" JustifyContent="Start" Wrap="Wrap" />
                <VerticalStackLayout x:Name="ListaHost" Spacing="18" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
