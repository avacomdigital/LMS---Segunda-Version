<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Avacom.Lms.Ops.Pages.CalificacionDetallePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F1F1F1"
    Shell.NavBarIsVisible="False"
    SizeChanged="OnPageSizeChanged">
    <!-- Detalle de una calificación (MOD-011 · FUN-122, FUN-123). Lo que dice el nodo de UNA calificación: su estado y versión, quién y cómo la calificó, cuatro cosas distintas (el
         resultado interno 0–100, la calificación presentada, el nivel de desempeño y el criterio de aprobación), la puntuación original y la efectiva, la retroalimentación y el
         historial de cambios. Para quien califica: ajustar (con teclado numérico táctil y motivo en frases), reabrir, publicar o retirar la publicación, valorar el nivel de desempeño y
         retroalimentar. Los paneles que llevan cajas de texto (ajuste, retroalimentación) viven en hosts que no se repintan: WinUI no deja mover un cuadro de texto de contenedor. -->
    <Grid x:Name="Raiz">
        <Grid RowDefinitions="Auto,Auto,*" Padding="44,24,48,16" RowSpacing="12">
            <Grid x:Name="Cabecera" Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="24" HorizontalOptions="Center" WidthRequest="1280">
                <VerticalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                    <Label Text="CALIFICACIÓN" FontFamily="InterRegular" FontSize="12" TextColor="#52525B" CharacterSpacing="2.5" />
                    <Label x:Name="TituloLabel" Text="Cargando…" FontFamily="InterMedium" FontSize="30" TextColor="#18181B" LineBreakMode="WordWrap" />
                    <Label x:Name="SubtituloLabel" Text="" FontFamily="InterLight" FontSize="15" TextColor="#52525B" LineBreakMode="WordWrap" />
                    <FlexLayout x:Name="PastillasHost" Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Start" Margin="0,4,0,0" />
                </VerticalStackLayout>
                <HorizontalStackLayout x:Name="AccionesHost" Grid.Column="1" Spacing="12" VerticalOptions="Center" />
            </Grid>
            <VerticalStackLayout x:Name="AvisoHost" Grid.Row="1" HorizontalOptions="Center" WidthRequest="1280" Spacing="8">
                <VerticalStackLayout x:Name="ConexionHost" Spacing="8" />
                <VerticalStackLayout x:Name="ResultadoHost" Spacing="8" />
            </VerticalStackLayout>
            <ScrollView x:Name="Desplazable" Grid.Row="2">
                <VerticalStackLayout x:Name="Cuerpo" HorizontalOptions="Center" WidthRequest="1280" Spacing="14" Padding="0,0,0,40">
                    <VerticalStackLayout x:Name="ResumenHost" Spacing="14" />
                    <VerticalStackLayout x:Name="QueHacerHost" Spacing="14" />
                    <VerticalStackLayout x:Name="AjusteHost" Spacing="14" />
                    <VerticalStackLayout x:Name="RetroHost" Spacing="14" />
                    <VerticalStackLayout x:Name="LecturaHost" Spacing="14" />
                    <VerticalStackLayout x:Name="HistorialHost" Spacing="14" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
