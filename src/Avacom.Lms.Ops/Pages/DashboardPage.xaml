<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Avacom.Lms.Ops.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ui="clr-namespace:Avacom.Lms.Ui.Controls;assembly=Avacom.Lms.Ui"
    xmlns:gfx="clr-namespace:Avacom.Lms.Ui.Graphics;assembly=Avacom.Lms.Ui"
    BackgroundColor="#EAF0F6"
    Shell.NavBarIsVisible="False"
    SizeChanged="OnPageSizeChanged">
    <Grid RowDefinitions="112,Auto,*">
        <!-- Fondo Aurora del Aula · Design System (capa más baja, sin captar toques). En el menú principal el panal es el
             único elemento hexagonal de la pantalla: sin retícula de hexágonos de fondo. -->
        <ui:FondoAurora Grid.RowSpan="3" />

        <!-- Cabecera del Aula · Design System: isla de marca neumórfica con el logo, arriba al centro; esquina izquierda con la fecha y la
             hora (sólo información) y esquina derecha con el nombre y el avatar, ambas neumórficas. -->
        <Grid ZIndex="3">
            <ui:IslaDeMarca />
            <ui:EsquinaFechaHora Margin="44,20,0,0" />
            <HorizontalStackLayout Spacing="12" HorizontalOptions="End" VerticalOptions="Start" Margin="0,20,44,0">
                <!-- RF-08: «Seguridad del aula» (PIN maestro, profesores registrados con él y puertas de entrada), sólo para la administración. Es un botón
                     y no una tesela para que se toque igual que el resto de la cabecera (y lo encuentre UI Automation). -->
                <!-- MOD-018: «Licencia» (estado, activación y renovación sin internet, copia y liberación) para la administración y el soporte técnico, que tienen license.read;
                     sin sesión el prototipo lo deja ver y el nodo decide. Mismo aspecto que «Seguridad del aula», a su lado. -->
                <!-- MOD-017: «Actualizaciones» (paquetes de AVACOM en memorias USB: traer, programar, aplicar y volver atrás) para quien tiene update.read: administración y soporte técnico. -->
                <Button x:Name="ActualizacionesButton" IsVisible="False" Text="Actualizaciones" AutomationId="dashboard-actualizaciones" HeightRequest="48" MinimumWidthRequest="110" Padding="18,0" CornerRadius="24" BackgroundColor="White" TextColor="#1F2433" BorderColor="#E3E6EC" BorderWidth="2" FontSize="14" VerticalOptions="Center" Clicked="OnActualizacionesClicked" />
                <Button x:Name="LicenciaButton" IsVisible="False" Text="Licencia" AutomationId="dashboard-licencia" HeightRequest="48" MinimumWidthRequest="110" Padding="18,0" CornerRadius="24" BackgroundColor="White" TextColor="#1F2433" BorderColor="#E3E6EC" BorderWidth="2" FontSize="14" VerticalOptions="Center" Clicked="OnLicenciaClicked" />
                <Button x:Name="SeguridadButton" IsVisible="False" Text="Seguridad del aula" HeightRequest="48" MinimumWidthRequest="120" Padding="18,0" CornerRadius="24" BackgroundColor="White" TextColor="#1F2433" BorderColor="#E3E6EC" BorderWidth="2" FontSize="14" VerticalOptions="Center" Clicked="OnSeguridadClicked" />
                <ui:CajaNeumorfica Relleno="22,8,8,8" VerticalOptions="Start">
                    <HorizontalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                            <Label x:Name="NombreLabel" FontFamily="LexendSemiBold" FontSize="16" Text="Ms. Carter" HorizontalTextAlignment="End" />
                            <Label x:Name="RolLabel" FontSize="13" Text="Profesora" TextColor="#5F6474" HorizontalTextAlignment="End" />
                        </VerticalStackLayout>
                        <Border BackgroundColor="#A81D81" HeightRequest="48" StrokeThickness="0" WidthRequest="48" StrokeShape="RoundRectangle 24">
                            <Label x:Name="InicialesLabel" FontFamily="LexendSemiBold" HorizontalOptions="Center" Text="EC" TextColor="White" VerticalOptions="Center" />
                        </Border>
                    </HorizontalStackLayout>
                </ui:CajaNeumorfica>
            </HorizontalStackLayout>
        </Grid>

        <!-- Las bandas PERSISTENTES (PIN maestro, licencia y estado del nodo) tienen su propia fila (Auto) ENCIMA del panal, no sobre él: antes se superponían
             y la banda de la licencia tapaba la mitad alta de «Reportes» durante los 30 días de evaluación (MOD-018, U-2). Sin ninguna banda la fila mide 0 y el
             panal queda donde siempre; con una, el panal baja lo que mida la banda y, si la ventana no da, se reescala (OnPageSizeChanged la descuenta). -->
        <VerticalStackLayout x:Name="BandasPersistentes" Grid.Row="1" ZIndex="7" Spacing="0" HorizontalOptions="Center" VerticalOptions="Start" Margin="24,0,24,0" MaximumWidthRequest="860" SizeChanged="OnPageSizeChanged">
            <!-- RF-09 · RN-08: banda del PIN maestro para administración y técnico (a 30 días o menos, vencido o sin configurar). Se queda mientras dure: no
                 se descarta, porque lo que avisa sigue pendiente. Al profesorado nunca se le muestra. -->
            <Border x:Name="PinBanner" IsVisible="False" Margin="0,8,0,4" Padding="18,10,10,10" BackgroundColor="#FFEDDF" Stroke="#FDD0AE" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label x:Name="PinBannerLabel" FontSize="15" TextColor="#9A3412" VerticalOptions="Center" LineBreakMode="WordWrap" />
                    <Button x:Name="PinBannerButton" Grid.Column="1" Text="Cambiar ahora" HeightRequest="40" MinimumWidthRequest="110" Padding="14,0" BackgroundColor="Transparent" TextColor="#9A3412" FontSize="14" Clicked="OnSeguridadClicked" />
                </Grid>
            </Border>
            <!-- MOD-018 · R-01: banda de la licencia (evaluación, por vencer, gracia, funciones en pausa, cupo, fecha, huella, programa modificado) para quien ve la licencia.
                 Persistente como la del PIN: no se descarta mientras lo que avisa siga pendiente. Vive SÓLO en el menú principal y NO se muestra con una clase abierta en este equipo
                 (ninguna alerta administrativa interrumpe una sesión activa). El tono y el texto los pone el código (ReglasDeLicencia.Banner). -->
            <Border x:Name="LicenciaBanner" IsVisible="False" AutomationId="licencia-banner" Margin="0,8,0,4" Padding="18,10,10,10" BackgroundColor="#E3F5FC" Stroke="#BCE5F5" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label x:Name="LicenciaBannerLabel" AutomationId="licencia-banner-texto" FontSize="15" TextColor="#075985" VerticalOptions="Center" LineBreakMode="WordWrap" />
                    <Button x:Name="LicenciaBannerButton" Grid.Column="1" Text="Ver la licencia" AutomationId="licencia-banner-ver" HeightRequest="40" MinimumWidthRequest="130" Padding="14,0" BackgroundColor="Transparent" TextColor="#075985" FontSize="14" Clicked="OnLicenciaClicked" />
                </Grid>
            </Border>
            <!-- MOD-015 · P-18: banda del estado del nodo, molde de la del PIN, SÓLO para «restringido» y «en recuperación», para la administración y el técnico, y NUNCA con una clase
                 abierta en este equipo (ningún aviso de plataforma interrumpe una clase, R-01). Lee el campo `nodo` de /health/ (público, sin tocar la base). -->
            <Border x:Name="NodoBanner" IsVisible="False" AutomationId="nodo-banner" Margin="0,8,0,4" Padding="18,10,10,10" BackgroundColor="#FFEDDF" Stroke="#FDD0AE" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label x:Name="NodoBannerLabel" AutomationId="nodo-banner-texto" FontSize="15" TextColor="#9A3412" VerticalOptions="Center" LineBreakMode="WordWrap" />
                    <Button x:Name="NodoBannerButton" Grid.Column="1" Text="Ver el equipo" AutomationId="nodo-banner-ver" HeightRequest="40" MinimumWidthRequest="130" Padding="14,0" BackgroundColor="Transparent" TextColor="#9A3412" FontSize="14" Clicked="OnNodoClicked" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <!-- MSG-021: aviso no bloqueante tras entrar (la entrada cerró la clase que esta persona tenía abierta en otro equipo). Se ve
             unos segundos SOBRE el tablero y se quita solo o con «Entendido»; nada espera una confirmación. Es transitorio: por eso se superpone
             en vez de mover el panal. -->
        <VerticalStackLayout Grid.Row="2" ZIndex="7" HorizontalOptions="Center" VerticalOptions="Start" Margin="24,10,24,0" MaximumWidthRequest="860">
            <Border x:Name="AvisoBanner" IsVisible="False" HorizontalOptions="Center" MaximumWidthRequest="760" Padding="18,10,10,10" BackgroundColor="#E3F5FC" Stroke="#BCE5F5" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label x:Name="AvisoLabel" FontSize="15" TextColor="#075985" VerticalOptions="Center" LineBreakMode="WordWrap" />
                    <Button Grid.Column="1" Text="Entendido" HeightRequest="44" MinimumWidthRequest="110" Padding="14,0" BackgroundColor="Transparent" TextColor="#075985" FontSize="14" Clicked="OnAvisoEntendido" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <AbsoluteLayout
            x:Name="MenuStage"
            Margin="0,0,0,104"
            AnchorY="0"
            Grid.Row="2"
            HeightRequest="441"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            WidthRequest="946">
            <!-- Panal del Aula · Design System: «Clase de hoy» en el centro exacto y el resto alrededor (anillo de seis y, si hay más, en los extremos
                 de la fila de arriba: 4 · 3 · 2). Las posiciones las pone el code-behind (Recolocar) según qué teselas ve el rol; las de LayoutBounds son de partida.
                 Asignaturas, Comunicación, Enciclopedia, Progreso, Calendario y Estudiantes quedan ocultas de la vista (los módulos siguen igual). -->
            <!-- Aro de color de la referencia anterior: oculto, porque en el Aula · Design System el panal es el único elemento hexagonal. -->
            <Image
                IsVisible="False"
                AbsoluteLayout.LayoutBounds="203,147,374,416"
                Aspect="AspectFit"
                InputTransparent="True"
                Source="colorhexagon.png"
                ZIndex="0" />

            <!-- «Reportes» (MOD-013 · Reporting): reportes de una clase, un estudiante y un grupo, uso de equipos y exportar a un archivo. Sólo la ven quienes pueden leer datos académicos
                 (profesorado, administración y reportes; el rol técnico no): sin sesión, el prototipo la deja ver y el nodo decide. Antes abría la demo «activity-monitor»; ésta sigue
                 accesible desde Reportes → «Visitantes y actividad» (ahí está «Vincular a un alumno», RF-09c). -->
