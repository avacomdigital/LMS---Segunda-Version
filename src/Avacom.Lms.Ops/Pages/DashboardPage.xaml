                IconGeometry="M221.8,175.94 C216.25,166.38 208,139.33 208,104 A80,80 0 1 0 48,104 C48,139.34 39.74,166.38 34.19,175.94 A16,16 0 0 0 48,200 H88.81 A40,40 0 0 0 167.19,200 H208 A16,16 0 0 0 221.8,175.94 Z M128,216 A24,24 0 0 1 105.38,200 H150.62 A24,24 0 0 1 128,216 Z M48,184 C55.7,170.76 64,140.08 64,104 A64,64 0 1 1 192,104 C192,140.05 200.28,170.73 208,184 Z" />

