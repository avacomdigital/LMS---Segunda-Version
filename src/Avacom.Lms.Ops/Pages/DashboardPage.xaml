        <Border Grid.RowSpan="2" Margin="0,0,0,28" Padding="8,4" BackgroundColor="#5A5A56" HeightRequest="60" HorizontalOptions="Center" StrokeThickness="0" VerticalOptions="End" WidthRequest="750" ZIndex="5">
            <Border.Shadow><Shadow Brush="#35000000" Offset="0,5" Radius="10" /></Border.Shadow>
            <Grid ColumnDefinitions="54,*,*,*,*,*,*,*,42" ColumnSpacing="0">
                <Border Margin="0" BackgroundColor="White" HeightRequest="48" StrokeThickness="0" WidthRequest="48"><Image HeightRequest="35" Source="avacom_mark.png" WidthRequest="31" /></Border>
                <Button Grid.Column="1" Text="⌘&#10;Menú principal" Style="{StaticResource DockButton}" />
                <Button Grid.Column="2" Text="▤&#10;Asignaturas" Style="{StaticResource DockButton}" Clicked="OnAssignmentsClicked" />
                <Button Grid.Column="3" Text="◉&#10;Clase de hoy" Style="{StaticResource DockButton}" Clicked="OnClassTodayClicked" />
                <Button Grid.Column="4" Text="▥&#10;Enciclopedia" Style="{StaticResource DockButton}" />
                <Button Grid.Column="5" Text="♙&#10;Grupos" Style="{StaticResource DockButton}" Clicked="OnGruposClicked" />
                <Button Grid.Column="6" Text="?&#10;Ayuda" Style="{StaticResource DockButton}" />
                <Button Grid.Column="7" Text="↪&#10;Cerrar sesión" Style="{StaticResource DockButton}" Clicked="OnLogoutClicked" />
                <Label Grid.Column="8" FontSize="24" HorizontalOptions="Center" Text="«" TextColor="White" VerticalOptions="Center" />
            </Grid>
        </Border>

        <Border Grid.RowSpan="2" Margin="0,0,18,18" Padding="4" BackgroundColor="White" HeightRequest="42" HorizontalOptions="End" StrokeThickness="0" VerticalOptions="End" WidthRequest="82" ZIndex="6">
