<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Avacom.Lms.Ops.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ui="clr-namespace:Avacom.Lms.Ui.Controls;assembly=Avacom.Lms.Ui"
    xmlns:gfx="clr-namespace:Avacom.Lms.Ui.Graphics;assembly=Avacom.Lms.Ui"
    BackgroundColor="#F1F1F1"
    Shell.NavBarIsVisible="False"
    SizeChanged="OnPageSizeChanged">
    <Grid RowDefinitions="86,*">
        <!-- Fondo decorativo (capa más baja, bajo cabecera, menú y dock): retícula de hexágonos grandes con las
             puntas redondeadas, en un solo GraphicsView que se adapta solo al tamaño de la ventana y la orientación.
             Se declara primero y sin ZIndex para quedar debajo de todo lo existente; InputTransparent: es 100 %
             decorativa y nunca captura toques, clics ni gestos. La tinta translúcida (negro al 10 %) da sobre el
             #F1F1F1 de la página el mismo contraste que el gris #E6E6E6 de la referencia sobre blanco. -->
        <GraphicsView Grid.RowSpan="2" InputTransparent="True" HorizontalOptions="Fill" VerticalOptions="Fill">
            <GraphicsView.Drawable>
                <gfx:RoundedHexagonBackgroundDrawable HexagonWidth="240" CornerRadius="12" Gap="6" StrokeColor="#1A000000" StrokeWidth="1.25" />
            </GraphicsView.Drawable>
        </GraphicsView>

        <Grid Padding="44,0" ColumnDefinitions="*,Auto" ZIndex="3">
            <HorizontalStackLayout Spacing="16" VerticalOptions="Center">
                <!-- El logotipo ya incluye el símbolo y la palabra «AVACOM»; sólo se
                     añade «CLASSROOM». 56 de alto equivale al tope de la versión web. -->
                <Image Aspect="AspectFit" HeightRequest="56" Source="avacom_logo.png" VerticalOptions="Center" WidthRequest="209" />
                <Label FontAttributes="Bold" FontSize="16" Text="CLASSROOM" TextColor="#52525B" VerticalTextAlignment="Center" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                <Border BackgroundColor="#977528" HeightRequest="48" StrokeThickness="0" WidthRequest="48">
                    <Label FontAttributes="Bold" HorizontalOptions="Center" Text="EC" TextColor="White" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                    <Label FontAttributes="Bold" FontSize="16" Text="Ms. Carter" />
                    <Label FontSize="13" Text="Profesora" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </Grid>

