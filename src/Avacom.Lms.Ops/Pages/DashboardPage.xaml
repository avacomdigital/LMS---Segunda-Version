            <ui:ProfessorHexTile x:Name="DispositivosTile" AbsoluteLayout.LayoutBounds="0,273,146,168" AccentColor="#0A72A6" Text="Dispositivos" IconSource="ico_dispositivos.png" Tapped="OnModuleTapped"
