            <ui:ProfessorHexTile x:Name="ClaseHoyTile" AbsoluteLayout.LayoutBounds="397,409,146,168" AccentColor="#047857" Glass="True" Text="Clase de hoy" IconSource="ico_clase.png" Tapped="OnModuleTapped"
