<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Avacom.Lms.Ops.Pages.ClaseCierrePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="48,40,48,60" Spacing="22" MaximumWidthRequest="960" HorizontalOptions="Center">
            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                <Border BackgroundColor="#E6F5EE" Padding="14,8" StrokeThickness="0" StrokeShape="RoundRectangle 999" HorizontalOptions="Center">
                    <Label Text="●  Clase terminada" FontSize="14" FontAttributes="Bold" TextColor="#019D60" />
                </Border>
                <Label x:Name="TituloLabel" Text="Resumen de la clase" FontSize="34" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                <Label x:Name="SubtituloLabel" Text="" FontSize="16" TextColor="#52525B" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
            </VerticalStackLayout>
            <VerticalStackLayout x:Name="AvisoHost" Spacing="10" />
            <FlexLayout x:Name="ResumenHost" Wrap="Wrap" Direction="Row" JustifyContent="Center" AlignItems="Start" />
            <!-- 007-09 · lo que trae el detalle del resumen y el anclaje: participación, pendientes, tarea de estudio y tema de la clase. -->
            <VerticalStackLayout x:Name="SeccionesHost" Spacing="18" />
            <VerticalStackLayout x:Name="AccionesHost" Spacing="12" HorizontalOptions="Center" Margin="0,12,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
