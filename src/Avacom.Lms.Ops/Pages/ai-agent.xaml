<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Avacom.Lms.Ops.Pages.AiAgentPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="White"
    Shell.NavBarIsVisible="False">
    <!-- AI Agent: la tableta 3D de AVACOM con su rostro animado. Es sólo visual: el dibujo (Three.js + el GLB de Blender) vive en Resources/Raw/wwwroot/ai-agent y corre
         dentro de un HybridWebView, sin red. Esta página sólo lo aloja, enseña el estado de arranque y cuenta los errores. El texto del agente (hoy vacío) y las animaciones se
         gobiernan desde aquí por AiAgentPage.ReproducirAsync / DetenerAsync / ExpresionAsync / TextoAsync cuando se conecte un agente. -->
    <Grid RowDefinitions="Auto,*">
        <Grid Padding="44,16,44,0" ColumnDefinitions="Auto,*" ColumnSpacing="20" ZIndex="3">
            <Button x:Name="VolverButton" AutomationId="ai-agent-volver" Text="‹  Menú principal" HeightRequest="44" MinimumWidthRequest="170" Padding="18,0" CornerRadius="12"
                    BackgroundColor="White" TextColor="#18181B" BorderColor="#17000000" BorderWidth="1" FontSize="14" VerticalOptions="Center" Clicked="OnVolverClicked" />
            <Label Grid.Column="1" Text="AI AGENT" FontFamily="InterRegular" FontSize="12" TextColor="#52525B" CharacterSpacing="2.5" VerticalOptions="Center" />
        </Grid>

        <Grid Grid.Row="1">
            <HybridWebView x:Name="Visor" AutomationId="ai-agent-visor" HybridRoot="wwwroot/ai-agent" DefaultFile="index.html" BackgroundColor="White" RawMessageReceived="OnMensajeDelVisor" />

            <!-- Estado del arranque del renderizador: sobre el visor mientras carga y, si falla, con el motivo. Desaparece cuando la página avisa que está lista. -->
            <Border x:Name="EstadoPanel" AutomationId="ai-agent-estado" ZIndex="5" BackgroundColor="White" StrokeThickness="0" HorizontalOptions="Fill" VerticalOptions="Fill">
                <VerticalStackLayout Spacing="16" HorizontalOptions="Center" VerticalOptions="Center" MaximumWidthRequest="620" Padding="24">
                    <ActivityIndicator x:Name="Cargando" IsRunning="True" Color="#18181B" HeightRequest="36" WidthRequest="36" />
                    <Label x:Name="EstadoLabel" AutomationId="ai-agent-estado-texto" Text="Preparando a AI Agent…" FontSize="18" TextColor="#52525B" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                    <Button x:Name="ReintentarButton" AutomationId="ai-agent-reintentar" IsVisible="False" Text="Reintentar" HeightRequest="44" MinimumWidthRequest="140" Padding="18,0" CornerRadius="12"
                            BackgroundColor="#18181B" TextColor="White" FontSize="14" HorizontalOptions="Center" Clicked="OnReintentarClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- Chat con el asistente: a la derecha, sobre el visor, para que el personaje quede en el tercio central. Se sigue pudiendo usar aunque el renderizador 3D falle (la
                 conversación es texto + voz; el personaje es un acompañante). Todo lo que pasa con la IA se resuelve en AiAgentPage.Chat.cs / ConversacionConAgente: este XAML sólo es la
                 estructura. Nada de sombras ni listas largas con relieve dentro del ScrollView (WinUI entra en LayoutCycle). -->
            <Border x:Name="ChatPanel" AutomationId="ai-agent-chat" ZIndex="6" HorizontalOptions="End" VerticalOptions="Fill" Margin="0,8,28,24" WidthRequest="400" Padding="0"
                    BackgroundColor="White" Stroke="#17000000" StrokeThickness="1">
                <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" RowSpacing="0">
                    <Grid Grid.Row="0" Padding="18,14,14,10" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="Conversación" FontFamily="InterMedium" FontSize="16" TextColor="#18181B" />
                            <Label x:Name="ServicioLabel" AutomationId="ai-agent-servicio" Text="Comprobando el asistente…" FontSize="12" TextColor="#71717A" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" x:Name="NuevaButton" AutomationId="ai-agent-nueva" Text="Nueva" HeightRequest="44" MinimumWidthRequest="84" Padding="14,0" CornerRadius="12" FontSize="14"
                                BackgroundColor="White" TextColor="#18181B" BorderColor="#17000000" BorderWidth="1" VerticalOptions="Center" Clicked="OnNuevaClicked" />
                    </Grid>

                    <ScrollView Grid.Row="1" x:Name="MensajesScroll" AutomationId="ai-agent-mensajes">
                        <VerticalStackLayout x:Name="MensajesHost" Spacing="10" Padding="14,6,14,10">
                            <Label x:Name="VacioLabel" Text="Pregúntame lo que quieras. Te respondo por escrito y, si quieres, en voz alta." FontSize="14" TextColor="#52525B" LineBreakMode="WordWrap" Margin="4,4,4,2" />
                            <FlexLayout x:Name="SugerenciasHost" Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Start" />
                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- Aviso: lo que la persona debe saber cuando algo no salió (con su botón, si reintentar sirve de algo). Un solo lugar, nunca una ventana. -->
                    <Border Grid.Row="2" x:Name="AvisoBorder" AutomationId="ai-agent-aviso" IsVisible="False" Margin="12,0,12,8" Padding="12,10" BackgroundColor="#FEF3F2" Stroke="#FECDCA" StrokeThickness="1">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">
                            <Label x:Name="AvisoLabel" AutomationId="ai-agent-aviso-texto" FontSize="14" TextColor="#B42318" LineBreakMode="WordWrap" />
                            <HorizontalStackLayout Spacing="8">
                                <Button x:Name="AvisoAccionButton" AutomationId="ai-agent-aviso-accion" IsVisible="False" HeightRequest="44" MinimumWidthRequest="120" Padding="16,0" CornerRadius="12" FontSize="14"
                                        BackgroundColor="#18181B" TextColor="White" Clicked="OnAvisoAccionClicked" />
                                <Button x:Name="AvisoCerrarButton" AutomationId="ai-agent-aviso-cerrar" Text="Cerrar" HeightRequest="44" MinimumWidthRequest="90" Padding="16,0" CornerRadius="12" FontSize="14"
                                        BackgroundColor="White" TextColor="#18181B" BorderColor="#17000000" BorderWidth="1" Clicked="OnAvisoCerrarClicked" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Grid Grid.Row="3" Padding="12,0,12,8" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Border Stroke="#17000000" StrokeThickness="1" BackgroundColor="#FAFAFA" Padding="12,0" HeightRequest="52">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <Entry x:Name="PreguntaEntry" AutomationId="ai-agent-pregunta" Placeholder="Escribe tu pregunta…" PlaceholderColor="#A1A1AA" TextColor="#18181B" FontSize="16"
                                   MaxLength="2000" ReturnType="Send" BackgroundColor="Transparent" VerticalOptions="Center" Completed="OnPreguntaCompleted" />
                        </Border>
                        <Button Grid.Column="1" x:Name="EnviarButton" AutomationId="ai-agent-enviar" Text="Enviar" HeightRequest="52" MinimumWidthRequest="96" Padding="18,0" CornerRadius="14" FontSize="15"
                                BackgroundColor="#18181B" TextColor="White" Clicked="OnEnviarClicked" />
                    </Grid>

                    <Grid Grid.Row="4" Padding="16,0,14,14" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label x:Name="VozLabel" Text="Leer las respuestas en voz alta" FontSize="13" TextColor="#52525B" VerticalOptions="Center" />
                        <Switch Grid.Column="1" x:Name="VozSwitch" AutomationId="ai-agent-voz" OnColor="#18181B" VerticalOptions="Center" Toggled="OnVozToggled" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
