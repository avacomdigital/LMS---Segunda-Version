<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Avacom.Lms.Ops.Pages.ExamenAplicarPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ui="clr-namespace:Avacom.Lms.Ui.Controls;assembly=Avacom.Lms.Ui"
    BackgroundColor="#EAF0F6"
    Shell.NavBarIsVisible="False">
    <!-- Estructura del Aula · Design System: isla de marca, fecha y hora y fondo liso (evaluar); la raíz de la pantalla va debajo, sin cambios. -->
    <ui:MarcoDs Aurora="False">
    <!-- Aplicar un examen (MOD-010 · Guion, pasos 1 a 4). Una sola tarjeta en el tercio central de la ventana: Grid *,*,* de ancho y, de alto, todo lo que deja la isla de marca (8 arriba, 40 abajo),
         con la tarjeta llenando la celda del centro (sin márgenes ni anchos máximos). La cabecera y el pie quedan fijos;
         sólo el cuerpo se desplaza. Nada exige teclado: todo son fichas y tarjetas que se tocan. El nivel nunca viene elegido. -->
    <Grid x:Name="Raiz" ColumnDefinitions="*,*,*" RowDefinitions="8,*,40">
        <Border Grid.Row="1" Grid.Column="1" Padding="28,22,22,22" BackgroundColor="#FFFFFF" Stroke="#E3E6EC" StrokeThickness="1" StrokeShape="RoundRectangle 24">
            <Border.Shadow><Shadow Brush="#1F2433" Offset="0,10" Radius="28" Opacity="0.10" /></Border.Shadow>
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">

                <VerticalStackLayout Grid.Row="0" Spacing="3" Padding="0,0,6,0">
                    <Label Text="APLICAR EXAMEN" FontFamily="Lexend" FontSize="12" TextColor="#4F5566" CharacterSpacing="2.5" />
                    <Label x:Name="TituloLabel" Text="Examen" FontFamily="LexendMedium" FontSize="26" TextColor="#1F2433" LineBreakMode="TailTruncation" MaxLines="2" />
                    <Label x:Name="SubtituloLabel" Text="" FontFamily="Lexend" FontSize="15" TextColor="#4F5566" LineBreakMode="TailTruncation" />
                </VerticalStackLayout>

                <ScrollView x:Name="Desplazable" Grid.Row="1">
                    <VerticalStackLayout x:Name="CuerpoHost" Spacing="24" Padding="0,0,10,12" />
                </ScrollView>

                <VerticalStackLayout Grid.Row="2" Spacing="10" Padding="0,0,6,0">
                    <VerticalStackLayout x:Name="AvisoHost" Spacing="8" />
                    <Label x:Name="ResumenLabel" FontFamily="LexendMedium" FontSize="16" TextColor="#4F5566" LineBreakMode="WordWrap" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                        <ContentView x:Name="CancelarSlot" Grid.Column="1" VerticalOptions="Center" />
                        <ContentView x:Name="AplicarSlot" Grid.Column="2" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
    </ui:MarcoDs>
</ContentPage>
