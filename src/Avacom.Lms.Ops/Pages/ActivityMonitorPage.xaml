<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Avacom.Lms.Ops.Pages.ActivityMonitorPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="68,*">
        <Grid BackgroundColor="White" Padding="28,0" ColumnDefinitions="Auto,*,Auto"><Button Text="← Volver" BackgroundColor="Transparent" TextColor="{StaticResource Ink}" Clicked="OnBack"/><Label Grid.Column="1" Text="Actividad en vivo" HorizontalOptions="Center" VerticalOptions="Center" FontSize="18" FontAttributes="Bold"/><Border Grid.Column="2" BackgroundColor="{StaticResource SuccessSoft}" Padding="12,7" StrokeThickness="0" VerticalOptions="Center"><Label Text="●  WebSocket · demo" TextColor="{StaticResource BrandGreen}"/></Border></Grid>
        <ScrollView Grid.Row="1"><VerticalStackLayout Padding="48,32,48,80" Spacing="24" MaximumWidthRequest="1120" HorizontalOptions="Center">
            <!-- RN-46 · RF-09c: quiénes entraron como visitante y desde qué tableta (datos reales del nodo), con «Vincular a un alumno» (RN-44). -->
            <VerticalStackLayout x:Name="VisitantesHost" Spacing="10" />
            <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Quiz: Conociendo México" Style="{StaticResource PageTitle}"/><Label Text="Álgebra Octavo B · Observa la pregunta actual y la nota al finalizar." Style="{StaticResource Muted}"/></VerticalStackLayout><Border Grid.Column="1" Padding="18,12" BackgroundColor="#FDECEC" StrokeThickness="0"><VerticalStackLayout><Label Text="3 / 4" FontSize="25" FontAttributes="Bold" TextColor="{StaticResource BrandRed}" HorizontalTextAlignment="Center"/><Label Text="conectados" Style="{StaticResource Muted}"/></VerticalStackLayout></Border></Grid>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16"><Border Padding="20"><VerticalStackLayout><Label Text="Pregunta promedio" Style="{StaticResource Muted}"/><Label Text="3 de 5" FontSize="26" FontAttributes="Bold"/></VerticalStackLayout></Border><Border Grid.Column="1" Padding="20"><VerticalStackLayout><Label Text="Finalizados" Style="{StaticResource Muted}"/><Label Text="1" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource BrandGreen}"/></VerticalStackLayout></Border><Border Grid.Column="2" Padding="20"><VerticalStackLayout><Label Text="Nota promedio" Style="{StaticResource Muted}"/><Label Text="80 / 100" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource BrandViolet}"/></VerticalStackLayout></Border></Grid>
            <Label Text="Estudiantes" FontSize="21" FontAttributes="Bold"/>
            <CollectionView ItemsSource="{Binding Students}" SelectionMode="None"><CollectionView.ItemTemplate><DataTemplate><Border Padding="18" Margin="0,0,0,10"><Grid ColumnDefinitions="54,2*,*,*,Auto" ColumnSpacing="14"><Border BackgroundColor="#3F3F46" WidthRequest="44" HeightRequest="44" StrokeThickness="0"><Label Text="{Binding Initials}" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/></Border><VerticalStackLayout Grid.Column="1" VerticalOptions="Center"><Label Text="{Binding Name}" FontAttributes="Bold"/><Label Text="{Binding Status}" Style="{StaticResource Muted}"/></VerticalStackLayout><VerticalStackLayout Grid.Column="2" VerticalOptions="Center"><Label Text="Pregunta" Style="{StaticResource Muted}"/><Label Text="{Binding CurrentQuestion, StringFormat='{0} de 5'}" FontAttributes="Bold"/></VerticalStackLayout><ProgressBar Grid.Column="3" Progress="{Binding Progress}" ProgressColor="{StaticResource BrandRed}" VerticalOptions="Center"/><Label Grid.Column="4" Text="{Binding ScoreLabel}" FontAttributes="Bold" TextColor="{StaticResource BrandGreen}" VerticalTextAlignment="Center"/></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
        </VerticalStackLayout></ScrollView>
    </Grid>
</ContentPage>
