<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style TargetType="ContentPage"><Setter Property="BackgroundColor" Value="{StaticResource CanvasGray}" /></Style>
    <Style TargetType="Label"><Setter Property="TextColor" Value="{StaticResource Ink}" /><Setter Property="FontFamily" Value="InterRegular" /></Style>
    <Style x:Key="PageTitle" TargetType="Label"><Setter Property="FontSize" Value="30" /><Setter Property="FontFamily" Value="InterSemiBold" /></Style>
    <Style x:Key="Muted" TargetType="Label"><Setter Property="TextColor" Value="{StaticResource InkMuted}" /><Setter Property="FontSize" Value="14" /></Style>
    <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="BackgroundColor" Value="{StaticResource BrandRed}" /><Setter Property="TextColor" Value="White" /><Setter Property="CornerRadius" Value="14" /><Setter Property="HeightRequest" Value="52" /><Setter Property="FontFamily" Value="InterMedium" /></Style>
    <Style x:Key="DarkButton" TargetType="Button"><Setter Property="BackgroundColor" Value="{StaticResource Ink}" /><Setter Property="TextColor" Value="White" /><Setter Property="CornerRadius" Value="14" /><Setter Property="HeightRequest" Value="52" /><Setter Property="FontFamily" Value="InterMedium" /></Style>
    <Style TargetType="Button"><Setter Property="FontFamily" Value="InterMedium" /></Style>
    <Style TargetType="Entry"><Setter Property="BackgroundColor" Value="White" /><Setter Property="HeightRequest" Value="52" /><Setter Property="TextColor" Value="{StaticResource Ink}" /><Setter Property="FontFamily" Value="InterRegular" /></Style>
    <Style TargetType="Border"><Setter Property="Stroke" Value="#16000000" /><Setter Property="StrokeShape" Value="RoundRectangle 20" /><Setter Property="BackgroundColor" Value="White" /></Style>
    <!-- Envoltorio neumórfico: bisel con luz arriba-izquierda y sombra abajo-derecha; la sombra exterior se define por instancia (teñida del color del botón) -->
    <Style x:Key="NeuButtonShell" TargetType="Border"><Setter Property="StrokeShape" Value="RoundRectangle 14" /><Setter Property="StrokeThickness" Value="1.5" /><Setter Property="Padding" Value="0" /><Setter Property="Stroke"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#B3FFFFFF" Offset="0" /><GradientStop Color="#26FFFFFF" Offset="0.45" /><GradientStop Color="#66000000" Offset="1" /></LinearGradientBrush></Setter.Value></Setter></Style>
    <Style x:Key="DockButton" TargetType="Button"><Setter Property="BackgroundColor" Value="Transparent" /><Setter Property="TextColor" Value="White" /><Setter Property="FontSize" Value="11" /><Setter Property="FontFamily" Value="InterMedium" /><Setter Property="Padding" Value="2,3" /><Setter Property="LineBreakMode" Value="WordWrap" /></Style>
</ResourceDictionary>
