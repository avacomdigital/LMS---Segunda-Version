<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Avacom.Lms.Ui.Controls.SearchFilterBar"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Avacom.Lms.Ui.Controls">
    <!-- Barra de búsqueda y filtros del Aula · Design System: caja blanca con contorno completo en Linea, radio 24 y sombra
         difusa; sin franja de colores (el DS no admite bordes de un solo lado ni degradados entre colores distintos).
         Fila 1: el campo de búsqueda (cápsula hundida con lupa), los picklists principales (FiltrosHost) y el botón
         «Más filtros». Fila 2 (plegada): los picklists secundarios (ExtraHost) y «Limpiar filtros». Los picklists
         los añade la pantalla con AgregarFiltro, porque sus valores salen del catálogo. -->
    <Border x:Name="Tarjeta" Padding="0" BackgroundColor="#FFFFFF" Stroke="#E3E6EC" StrokeShape="RoundRectangle 24" StrokeThickness="1">
        <Border.Shadow><Shadow Brush="#1F2433" Opacity="0.09" Offset="0,8" Radius="20" /></Border.Shadow>
        <Grid RowDefinitions="0,Auto,Auto">
            <!-- Antigua línea de categorías: oculta (fila de alto 0). -->
            <Grid Grid.Row="0" IsVisible="False" ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="0">
                <BoxView Color="#F6C3C4" />
                <BoxView Grid.Column="1" Color="#F3E29A" />
                <BoxView Grid.Column="2" Color="#BFE6D3" />
                <BoxView Grid.Column="3" Color="#BCE5F5" />
                <BoxView Grid.Column="4" Color="#E8C2DD" />
                <BoxView Grid.Column="5" Color="#E3E6EC" />
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Padding="16,14">
                <!-- Campo de búsqueda del DS: blanco con contorno completo de 2 px y radio m 16. -->
                <Border x:Name="Campo" BackgroundColor="#FFFFFF" Stroke="#E3E6EC" HeightRequest="52" Padding="16,0" StrokeShape="RoundRectangle 16" StrokeThickness="2" VerticalOptions="Center">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Path Aspect="Uniform" Data="M229.66,218.34 L179.59,168.28 A88.11,88.11 0 1 0 168.28,179.59 L218.34,229.66 A8,8 0 0 0 229.66,218.34 Z M40,112 A72,72 0 1 1 112,184 A72.08,72.08 0 0 1 40,112 Z" Fill="#4F5566" HeightRequest="20" VerticalOptions="Center" WidthRequest="20" />
                        <Entry x:Name="Entrada" Grid.Column="1" BackgroundColor="Transparent" ClassId="neumo" FontFamily="Lexend" FontSize="16" Placeholder="Buscar cursos, temas o códigos" PlaceholderColor="#5F6474" ReturnType="Search" Completed="OnCompletado" TextChanged="OnTextoCambiado" TextColor="#1F2433" VerticalOptions="Center" />
                    </Grid>
                </Border>
                <HorizontalStackLayout x:Name="FiltrosHost" Grid.Column="1" Spacing="10" VerticalOptions="Center" />
                <controls:GlassButton x:Name="MasBtn" Grid.Column="2" Clicked="OnMasFiltros" CornerRadius="16" FontSize="15" HeightRequest="48" Text="Más filtros" VerticalOptions="Center" WidthRequest="150" />
            </Grid>
            <Grid x:Name="ExtraFila" Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="False" Padding="14,0,14,12">
                <HorizontalStackLayout x:Name="ExtraHost" Spacing="10" VerticalOptions="Center" />
                <controls:GlassButton x:Name="LimpiarBtn" Grid.Column="1" Clicked="OnLimpiar" CornerRadius="16" FontSize="15" HeightRequest="48" Text="Limpiar filtros" VerticalOptions="Center" WidthRequest="170" />
            </Grid>
        </Grid>
    </Border>
</ContentView>
