<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Avacom.Lms.Ui.Controls.VerticalNavigation"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <ContentView.Resources>
        <!-- Opción de la barra inferior del Aula · Design System: icono sólido de 32 sobre la etiqueta 13/500 en tinta, en una
             cápsula de 64 de alto. El estado activo (azul 50), el encima y el pulsado los pinta el code-behind. -->
        <Style x:Key="NavItem" TargetType="Border">
            <Setter Property="HeightRequest" Value="64" />
            <Setter Property="MinimumHeightRequest" Value="64" />
            <Setter Property="MinimumWidthRequest" Value="112" />
            <Setter Property="StrokeShape" Value="RoundRectangle 32" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="Padding" Value="14,0" />
        </Style>
        <Style x:Key="NavIcon" TargetType="Image">
            <Setter Property="WidthRequest" Value="32" />
            <Setter Property="HeightRequest" Value="32" />
            <Setter Property="Aspect" Value="AspectFit" />
            <Setter Property="HorizontalOptions" Value="Center" />
        </Style>
        <Style x:Key="NavLabel" TargetType="Label">
            <Setter Property="FontFamily" Value="LexendMedium" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="#1F2433" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="LineBreakMode" Value="NoWrap" />
        </Style>
    </ContentView.Resources>
    <!-- Barra inferior del DS (antes, menú lateral): de izquierda a derecha, los fijos (Menú principal y Lección) y, tras un
         separador de espacio, los de sistema (Configuración y Cerrar sesión), que el DS deja al final de la barra. -->
    <HorizontalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
        <Border x:Name="MenuPrincipalItem" Style="{StaticResource NavItem}">
            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                <Image Style="{StaticResource NavIcon}" Source="barra_menu.png" />
                <Label Style="{StaticResource NavLabel}" Text="Menú principal" />
            </VerticalStackLayout>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMenuTapped" />
                <PointerGestureRecognizer PointerEntered="OnEntrar" PointerExited="OnSalir" PointerPressed="OnPresionar" PointerReleased="OnSoltar" />
            </Border.GestureRecognizers>
        </Border>
        <Border x:Name="LeccionItem" Style="{StaticResource NavItem}">
            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                <Image Style="{StaticResource NavIcon}" Source="barra_lamina.png" />
                <Label Style="{StaticResource NavLabel}" Text="Lección" />
            </VerticalStackLayout>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnLeccionTapped" />
                <PointerGestureRecognizer PointerEntered="OnEntrar" PointerExited="OnSalir" PointerPressed="OnPresionar" PointerReleased="OnSoltar" />
            </Border.GestureRecognizers>
        </Border>
        <!-- Separa los fijos de los de sistema con espacio, sin línea (el DS no dibuja divisores). -->
        <BoxView x:Name="Separador" Color="Transparent" WidthRequest="24" HeightRequest="1" />
        <Border x:Name="ConfiguracionItem" Style="{StaticResource NavItem}">
            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                <Image Style="{StaticResource NavIcon}" Source="barra_engrane.png" />
                <Label Style="{StaticResource NavLabel}" Text="Configuración" />
            </VerticalStackLayout>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnConfiguracionTapped" />
                <PointerGestureRecognizer PointerEntered="OnEntrar" PointerExited="OnSalir" PointerPressed="OnPresionar" PointerReleased="OnSoltar" />
            </Border.GestureRecognizers>
        </Border>
        <Border x:Name="SalirItem" Style="{StaticResource NavItem}">
            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                <Image Style="{StaticResource NavIcon}" Source="barra_salir.png" />
                <Label Style="{StaticResource NavLabel}" Text="Cerrar sesión" />
            </VerticalStackLayout>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSalirTapped" />
                <PointerGestureRecognizer PointerEntered="OnEntrar" PointerExited="OnSalir" PointerPressed="OnPresionar" PointerReleased="OnSoltar" />
            </Border.GestureRecognizers>
        </Border>
    </HorizontalStackLayout>
</ContentView>
