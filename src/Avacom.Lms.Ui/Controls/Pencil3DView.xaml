<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="Avacom.Lms.Ui.Controls.Pencil3DView" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" InputTransparent="True" BackgroundColor="Transparent">
    <!-- Sólo decorativo: ni el contenedor ni el lienzo capturan toques. El lienzo es transparente (sólo se pinta el lápiz)
         y entra en fundido: opacidad 0 → 1 y escala 0,94 → 1 cuando el modelo está cargado (ver el code-behind). -->
    <GraphicsView x:Name="Lienzo" InputTransparent="True" BackgroundColor="Transparent" Opacity="0" Scale="0.94" HorizontalOptions="Fill" VerticalOptions="Fill"/>
</ContentView>
