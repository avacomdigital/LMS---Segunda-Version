<?xml version="1.0" encoding="UTF-8" ?>
<!-- Aula · Design System v1.0: Lexend, cajas blancas con contorno completo y sombra difusa, botones en píldora. Sin bisel neumórfico. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style TargetType="ContentPage"><Setter Property="BackgroundColor" Value="{StaticResource Fondo}" /></Style>
    <Style TargetType="Label"><Setter Property="TextColor" Value="{StaticResource Tinta}" /><Setter Property="FontFamily" Value="Lexend" /></Style>
    <Style x:Key="PageTitle" TargetType="Label"><Setter Property="FontSize" Value="30" /><Setter Property="FontFamily" Value="LexendSemiBold" /></Style>
    <Style x:Key="Muted" TargetType="Label"><Setter Property="TextColor" Value="{StaticResource Tinta2}" /><Setter Property="FontSize" Value="14" /></Style>
    <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Background" Value="{StaticResource DegradadoPrincipal}" /><Setter Property="TextColor" Value="White" /><Setter Property="CornerRadius" Value="28" /><Setter Property="HeightRequest" Value="56" /><Setter Property="FontFamily" Value="LexendMedium" /><Setter Property="Padding" Value="24,0" /></Style>
    <Style x:Key="DarkButton" TargetType="Button"><Setter Property="BackgroundColor" Value="{StaticResource Superficie}" /><Setter Property="TextColor" Value="{StaticResource Tinta}" /><Setter Property="BorderColor" Value="{StaticResource Linea}" /><Setter Property="BorderWidth" Value="2" /><Setter Property="CornerRadius" Value="28" /><Setter Property="HeightRequest" Value="56" /><Setter Property="FontFamily" Value="LexendMedium" /><Setter Property="Padding" Value="24,0" /></Style>
    <Style TargetType="Button"><Setter Property="FontFamily" Value="LexendMedium" /></Style>
    <Style TargetType="Entry"><Setter Property="BackgroundColor" Value="{StaticResource Superficie}" /><Setter Property="HeightRequest" Value="56" /><Setter Property="TextColor" Value="{StaticResource Tinta}" /><Setter Property="PlaceholderColor" Value="{StaticResource Tinta3}" /><Setter Property="FontFamily" Value="Lexend" /></Style>
    <Style TargetType="Border"><Setter Property="Stroke" Value="{StaticResource Linea}" /><Setter Property="StrokeShape" Value="RoundRectangle 24" /><Setter Property="BackgroundColor" Value="{StaticResource Superficie}" /></Style>
    <!-- Cápsula de un botón: sólo lleva la forma de píldora y la sombra difusa (por instancia, del color del botón). Sin bisel: el neumorfismo vive sólo en la isla de marca. -->
    <Style x:Key="NeuButtonShell" TargetType="Border"><Setter Property="StrokeShape" Value="RoundRectangle 28" /><Setter Property="StrokeThickness" Value="0" /><Setter Property="Padding" Value="0" /><Setter Property="Stroke" Value="Transparent" /></Style>
    <!-- Botones de la barra inferior del menú principal: transparentes sobre la barra blanca, icono arriba y etiqueta debajo (ContentLayout se pone por botón) -->
    <Style x:Key="DockButton" TargetType="Button"><Setter Property="BackgroundColor" Value="Transparent" /><Setter Property="BorderWidth" Value="0" /><Setter Property="BorderColor" Value="Transparent" /><Setter Property="CornerRadius" Value="20" /><Setter Property="TextColor" Value="{StaticResource Tinta}" /><Setter Property="FontSize" Value="11" /><Setter Property="FontFamily" Value="LexendMedium" /><Setter Property="Padding" Value="12,4" /><Setter Property="LineBreakMode" Value="NoWrap" /></Style>
</ResourceDictionary>
