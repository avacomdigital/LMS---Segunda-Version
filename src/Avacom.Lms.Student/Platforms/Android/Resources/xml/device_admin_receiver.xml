<?xml version="1.0" encoding="utf-8"?>
<!-- Las políticas que declara el receptor de administración (kiosk.md §3.2). force-lock y disable-camera son las que la guía exige; Lock Task y
     las restricciones de usuario no necesitan declararse aquí: las concede ser Device Owner (dpm set-device-owner), no esta lista. -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
        <disable-camera />
    </uses-policies>
</device-admin>
