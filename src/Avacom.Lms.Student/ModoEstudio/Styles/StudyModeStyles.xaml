<?xml version="1.0" encoding="utf-8" ?>
<!-- «Modo estudio · Mis lecciones»: tokens y estilos de la pantalla. Continúan el lenguaje del LMS (Apple Education en jerarquía y aire,
     Duolingo en la claridad de las acciones): blanco, mucho espacio, separadores casi invisibles, estados en píldoras pequeñas y una
     sola acción fuerte por tarjeta. Los colores comunican estado (amarillo pendiente · azul en curso · verde completada/disponible ·
     rojo suave vencida); no decoran. Tipografía Inter (pesos 400/500/600 registrados en MauiProgram; no hay 700, no se sintetiza). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===================================================================================== colores -->
    <Color x:Key="StudyInk">#1D1D1F</Color>
    <Color x:Key="StudyMuted">#6E6E73</Color>
    <Color x:Key="StudyMutedStrong">#5F6368</Color>
    <Color x:Key="StudyBorder">#E8E8ED</Color>
    <Color x:Key="StudyBorderStrong">#D2D2D7</Color>
    <Color x:Key="StudySoft">#F5F5F7</Color>
    <Color x:Key="StudySurface">#FBFBFD</Color>
    <Color x:Key="StudyGreen">#019D60</Color>
    <Color x:Key="StudyGreenInk">#017A48</Color>
    <Color x:Key="StudyBlue">#01A4E1</Color>
    <Color x:Key="StudyBlueInk">#02739E</Color>
    <Color x:Key="StudyBlueSoft">#E5F5FB</Color>
    <Color x:Key="StudyAmberInk">#806600</Color>
    <Color x:Key="StudyAmberSoft">#FFF7D6</Color>
    <Color x:Key="StudyRedInk">#C1191D</Color>
    <Color x:Key="StudyTrack">#E9E9E9</Color>

    <SolidColorBrush x:Key="StudyBorderBrush" Color="#E8E8ED" />
    <SolidColorBrush x:Key="StudyBlueBorderBrush" Color="#CDE9F5" />
    <SolidColorBrush x:Key="StudyButtonBorderBrush" Color="#D2D2D7" />
    <SolidColorBrush x:Key="StudyCloseBorderBrush" Color="#E5E5E5" />
    <SolidColorBrush x:Key="StudyTransparentBrush" Color="Transparent" />

    <!-- ============================================================================== superficies -->
    <!-- El modal: blanco, 26 de radio (22–28 pedidos), sin sombra propia (las capas de sombra van detrás, en la página). -->
    <Style x:Key="StudyModalCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="StrokeShape" Value="RoundRectangle 26" />
        <Setter Property="Stroke" Value="{StaticResource StudyBorderBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Una lección: tarjeta grande y aireada, para tocarla con el dedo. -->
    <Style x:Key="StudyLessonCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="Stroke" Value="{StaticResource StudyBorderBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="22,20" />
    </Style>

    <!-- Bloques dentro de la tarjeta (práctica, evaluación): más suaves que la tarjeta que los contiene. -->
    <Style x:Key="StudyInset" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource StudySurface}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Stroke" Value="{StaticResource StudyBorderBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="16,14" />
    </Style>

    <Style x:Key="StudyChip" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 999" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Stroke" Value="{StaticResource StudyTransparentBrush}" />
        <Setter Property="Padding" Value="11,5" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="StudyDivider" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{StaticResource StudyBorder}" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <!-- ================================================================================= tipografía -->
    <Style x:Key="StudyModalTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="TextColor" Value="{StaticResource StudyInk}" />
    </Style>

    <Style x:Key="StudyModalSubtitle" TargetType="Label">
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{StaticResource StudyMuted}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="StudyEyebrow" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="CharacterSpacing" Value="0.9" />
        <Setter Property="TextColor" Value="{StaticResource StudyMuted}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="MaxLines" Value="1" />
    </Style>

    <Style x:Key="StudyCardTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="TextColor" Value="{StaticResource StudyInk}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="StudyBody" TargetType="Label">
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource StudyMuted}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="StudyMeta" TargetType="Label">
        <Setter Property="FontFamily" Value="InterMedium" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource StudyMuted}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="StudyPercent" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource StudyInk}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="StudyChipLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="CharacterSpacing" Value="0.5" />
        <Setter Property="LineBreakMode" Value="NoWrap" />
    </Style>

    <!-- ==================================================================================== botones -->
    <!-- Todos los botones se hunden un poco al pulsar (escala 0,98) y miden 44–48 de alto: el dedo cabe (mínimo táctil 44–48 dp). -->
    <Style x:Key="StudyButtonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="InterMedium" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="LineBreakMode" Value="NoWrap" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters><Setter Property="Scale" Value="1" /><Setter Property="Opacity" Value="1" /></VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters><Setter Property="Scale" Value="0.98" /></VisualState.Setters>
                    </VisualState>
                    <!-- Deshabilitado: se ve atenuado (no sólo «no responde»). -->
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters><Setter Property="Opacity" Value="0.4" /></VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Filtros: píldoras, no pestañas con subrayado. Normal #F5F5F7 / #5F6368; seleccionado #1D1D1F / blanco (DataTrigger en la página). -->
    <Style x:Key="StudyPill" TargetType="Button" BasedOn="{StaticResource StudyButtonBase}">
        <Setter Property="BackgroundColor" Value="{StaticResource StudySoft}" />
        <Setter Property="TextColor" Value="{StaticResource StudyMutedStrong}" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="120" />
    </Style>

    <Style x:Key="StudyPrimaryButton" TargetType="Button" BasedOn="{StaticResource StudyButtonBase}">
        <Setter Property="BackgroundColor" Value="{StaticResource StudyInk}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="ContentLayout" Value="Right,10" />
        <Setter Property="FontFamily" Value="InterSemiBold" />
    </Style>

    <Style x:Key="StudySecondaryButton" TargetType="Button" BasedOn="{StaticResource StudyButtonBase}">
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="TextColor" Value="{StaticResource StudyInk}" />
        <Setter Property="BorderColor" Value="{StaticResource StudyBorderStrong}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HeightRequest" Value="46" />
        <Setter Property="ContentLayout" Value="Left,8" />
    </Style>

    <Style x:Key="StudyPracticeButton" TargetType="Button" BasedOn="{StaticResource StudyButtonBase}">
        <Setter Property="BackgroundColor" Value="{StaticResource StudyBlueSoft}" />
        <Setter Property="TextColor" Value="{StaticResource StudyBlueInk}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HeightRequest" Value="46" />
        <Setter Property="ContentLayout" Value="Right,8" />
        <Setter Property="FontFamily" Value="InterSemiBold" />
    </Style>

    <Style x:Key="StudyGhostButton" TargetType="Button" BasedOn="{StaticResource StudyButtonBase}">
        <Setter Property="BackgroundColor" Value="{StaticResource StudySoft}" />
        <Setter Property="TextColor" Value="{StaticResource StudyInk}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HeightRequest" Value="44" />
    </Style>

    <!-- El botón X del modal: redondo, blanco, borde #E5E5E5, 44 × 44. -->
    <Style x:Key="StudyCloseButton" TargetType="Button" BasedOn="{StaticResource StudyButtonBase}">
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="BorderColor" Value="{StaticResource StudyCloseBorderBrush}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalOptions" Value="Start" />
    </Style>

    <!-- El «⋯» de una descarga disponible: redondo y discreto. -->
    <Style x:Key="StudyIconButton" TargetType="Button" BasedOn="{StaticResource StudyButtonBase}">
        <Setter Property="BackgroundColor" Value="{StaticResource StudySoft}" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- El primer paso de la práctica y de la lección: los mandos de navegación. -->
    <Style x:Key="StudyNavButton" TargetType="Button" BasedOn="{StaticResource StudyButtonBase}">
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="TextColor" Value="{StaticResource StudyInk}" />
        <Setter Property="BorderColor" Value="{StaticResource StudyBorderStrong}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="MinimumWidthRequest" Value="120" />
    </Style>
</ResourceDictionary>
