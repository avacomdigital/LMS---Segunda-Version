<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Avacom.Lms.Student.Pages.StudentMenuPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:ui="clr-namespace:Avacom.Lms.Ui.Controls;assembly=Avacom.Lms.Ui" xmlns:gfx="clr-namespace:Avacom.Lms.Ui.Graphics;assembly=Avacom.Lms.Ui" Shell.NavBarIsVisible="False" SizeChanged="OnPageSizeChanged">
    <Grid RowDefinitions="86,*,96" BackgroundColor="{StaticResource CanvasGray}">
        <!-- Fondo decorativo (capa más baja, bajo cabecera, hexágonos y barra inferior): retícula de hexágonos grandes con las
             puntas redondeadas, en un solo GraphicsView que se adapta solo al tamaño de la ventana y a la orientación. Se declara
             primero y sin ZIndex para quedar debajo de todo lo existente; InputTransparent: es 100 % decorativa y nunca captura
             toques, clics ni gestos. La tinta translúcida (negro al 10 %) da sobre el #F1F1F1 de la página el mismo contraste que
             el gris #E6E6E6 de la referencia sobre blanco (igual que el menú de OPS). -->
        <GraphicsView Grid.RowSpan="3" InputTransparent="True" HorizontalOptions="Fill" VerticalOptions="Fill">
            <GraphicsView.Drawable>
                <gfx:RoundedHexagonBackgroundDrawable HexagonWidth="240" CornerRadius="12" Gap="6" StrokeColor="#1A000000" StrokeWidth="1.25" />
            </GraphicsView.Drawable>
        </GraphicsView>

        <!-- Cabecera como la de OPS y la del diseño de referencia: el logotipo ya incluye el símbolo y la palabra «AVACOM», así que sólo se
             añade «CLASSROOM»; a la derecha, el alumno con su avatar hexagonal. -->
        <Grid Padding="44,0" ColumnDefinitions="*,Auto" ZIndex="3">
            <HorizontalStackLayout Spacing="16" VerticalOptions="Center">
                <Image Aspect="AspectFit" HeightRequest="56" Source="avacom_logo.png" VerticalOptions="Center" WidthRequest="209" />
                <Label FontAttributes="Bold" FontSize="16" Text="CLASSROOM" TextColor="#52525B" VerticalTextAlignment="Center" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                <Grid HeightRequest="51" WidthRequest="44" VerticalOptions="Center">
                    <Path Aspect="Fill" Data="M 67,7 Q 80,0 93,7 L 147,39 Q 160,47 160,61 L 160,123 Q 160,137 147,145 L 93,177 Q 80,184 67,177 L 13,145 Q 0,137 0,123 L 0,61 Q 0,47 13,39 Z" Fill="#6B6B6B" InputTransparent="True" />
                    <Label x:Name="Iniciales" Text="EM" TextColor="White" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>
                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                    <Label x:Name="StudentName" Text="Ethan" FontAttributes="Bold" FontSize="16" TextColor="#2F2F33" />
                    <Label Text="Estudiante" FontSize="13" TextColor="#75757C" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="4" Padding="16,12,16,30" HorizontalOptions="Center">
                <VerticalStackLayout HorizontalOptions="Center" Margin="0,0,0,10">
                    <Label x:Name="WelcomeLabel" Text="Bienvenido" FontSize="25" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                    <Label Text="¿Qué quieres hacer hoy?" Style="{StaticResource Muted}" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
                <!-- Tablero de opciones, con la misma geometría que el menú de OPS (teselas de 146 x 168, paso de 159 en horizontal y de
                     136,5 en vertical) y las siete celdas del estudiante del diseño de referencia: Asignaturas y Comunicación arriba,
                     Enciclopedia, Perfil y Progreso en medio, Calendario y Ayuda abajo, todas sobre el aro de color. «Clase en vivo» no
                     existe en la referencia: ocupa la celda contigua a Asignaturas, fuera del aro, y conserva el orden de lectura.
                     Se diseña en unidades de OPS (441 de alto más 20 de holgura por debajo: sin ella el recorte del contenedor corta la punta inferior y las sombras de las teselas de abajo) y el code-behind lo escala al espacio disponible (EscenarioBox toma el tamaño ya escalado
                     para que el ScrollView mida bien). Las seis opciones sin acción todavía no llevan Tapped. -->
                <Grid x:Name="EscenarioBox" WidthRequest="543.5" HeightRequest="461" HorizontalOptions="Center">
                    <AbsoluteLayout x:Name="Escenario" AnchorX="0" AnchorY="0" HeightRequest="461" HorizontalOptions="Start" VerticalOptions="Start" WidthRequest="543.5">
                        <!-- Envolvente medida sobre la referencia, como en OPS. El SVG conserva 587:654 y queda alineado con los seis huecos del núcleo hexagonal. -->
                        <Image AbsoluteLayout.LayoutBounds="124,11,374,416" Aspect="AspectFit" InputTransparent="True" Source="colorhexagon.png" ZIndex="0" />

                        <ui:ProfessorHexTile AbsoluteLayout.LayoutBounds="0,0,146,168" AccentColor="#A81D81" Text="Clase en vivo" Tapped="OnClaseEnVivo"
                            IconGeometry="M128,88 A40,40 0 1 0 168,128 A40,40 0 0 0 128,88 Z M128,152 A24,24 0 1 1 152,128 A24,24 0 0 1 128,152 Z M201.71,159.14 A80,80 0 0 1 187.63,181.34 A8,8 0 0 1 175.71,170.67 A63.95,63.95 0 0 0 175.71,85.34 A8,8 0 1 1 187.63,74.67 A80.08,80.08 0 0 1 201.71,159.14 Z M69,103.09 A64,64 0 0 0 80.26,170.67 A8,8 0 0 1 68.34,181.34 A79.93,79.93 0 0 1 68.34,74.67 A8,8 0 1 1 80.29,85.34 A63.77,63.77 0 0 0 69,103.09 Z M248,128 A119.58,119.58 0 0 1 213.71,212 A8,8 0 1 1 202.29,200.8 A103.9,103.9 0 0 0 202.29,55.24 A8,8 0 1 1 213.71,44 A119.58,119.58 0 0 1 248,128 Z M53.71,200.78 A8,8 0 1 1 42.29,212 A119.87,119.87 0 0 1 42.29,44 A8,8 0 1 1 53.71,55.2 A103.9,103.9 0 0 0 53.71,200.78 Z" />
                        <ui:ProfessorHexTile AbsoluteLayout.LayoutBounds="159,0,146,168" AccentColor="#E5282C" Text="Asignaturas" Tapped="OnCourses"
                            IconGeometry="M232,48 H160 A40,40 0 0 0 128,64 A40,40 0 0 0 96,48 H24 A8,8 0 0 0 16,56 V200 A8,8 0 0 0 24,208 H96 A24,24 0 0 1 120,232 A8,8 0 0 0 136,232 A24,24 0 0 1 160,208 H232 A8,8 0 0 0 240,200 V56 A8,8 0 0 0 232,48 Z M96,192 H32 V64 H96 A24,24 0 0 1 120,88 V200 A39.81,39.81 0 0 0 96,192 Z M224,192 H160 A39.81,39.81 0 0 0 136,200 V88 A24,24 0 0 1 160,64 H224 Z" />
                        <ui:ProfessorHexTile AbsoluteLayout.LayoutBounds="318,0,146,168" AccentColor="#C8222F" Text="Comunicación"
                            IconGeometry="M221.8,175.94 C216.25,166.38 208,139.33 208,104 A80,80 0 1 0 48,104 C48,139.34 39.74,166.38 34.19,175.94 A16,16 0 0 0 48,200 H88.81 A40,40 0 0 0 167.19,200 H208 A16,16 0 0 0 221.8,175.94 Z M128,216 A24,24 0 0 1 105.38,200 H150.62 A24,24 0 0 1 128,216 Z M48,184 C55.7,170.76 64,140.08 64,104 A64,64 0 1 1 192,104 C192,140.05 200.28,170.73 208,184 Z" />
                        <ui:ProfessorHexTile AbsoluteLayout.LayoutBounds="79.5,136.5,146,168" AccentColor="#F2C600" Text="Enciclopedia"
                            IconGeometry="M231.65,194.55 L198.46,36.75 A16,16 0 0 0 179.46,24.36 L132.65,34.42 A16.08,16.08 0 0 0 120.35,53.42 L153.54,211.22 A16,16 0 0 0 169.16,224 A16.25,16.25 0 0 0 172.54,223.64 L219.35,213.58 A16.09,16.09 0 0 0 231.65,194.55 Z M136,50.15 L182.8,40.06 L186.13,55.93 L139.33,66 Z M142.62,81.62 L189.44,71.57 L192.78,87.47 L146,97.53 Z M149.26,113.19 L196.08,103.13 L209.38,166.37 L162.56,176.43 Z M216,197.94 L169.2,207.94 L165.87,192.07 L212.67,182 Z M104,32 H56 A16,16 0 0 0 40,48 V208 A16,16 0 0 0 56,224 H104 A16,16 0 0 0 120,208 V48 A16,16 0 0 0 104,32 Z M56,48 H104 V64 H56 Z M56,80 H104 V176 H56 Z M104,208 H56 V192 H104 Z" />
                        <ui:ProfessorHexTile AbsoluteLayout.LayoutBounds="238.5,136.5,146,168" AccentColor="#18181B" Text="Perfil"
                            IconGeometry="M230.92,212 C215.69,185.67 192.22,166.78 164.83,157.84 A72,72 0 1 0 91.17,157.84 C63.78,166.78 40.31,185.66 25.08,212 A8,8 0 1 0 38.93,220 C57.77,187.44 91.07,168 128,168 C164.93,168 198.23,187.44 217.07,220 A8,8 0 1 0 230.92,212 Z M72,96 A56,56 0 1 1 128,152 A56.06,56.06 0 0 1 72,96 Z" />
                        <ui:ProfessorHexTile AbsoluteLayout.LayoutBounds="397.5,136.5,146,168" AccentColor="#A62080" Text="Progreso"
                            IconGeometry="M232,208 A8,8 0 0 1 224,216 H32 A8,8 0 0 1 24,208 V48 A8,8 0 0 1 40,48 V156.69 L90.34,106.34 A8,8 0 0 1 101.66,106.34 L128,132.69 L180.69,80 H160 A8,8 0 0 1 160,64 H200 A8,8 0 0 1 208,72 V112 A8,8 0 0 1 192,112 V91.31 L133.66,149.66 A8,8 0 0 1 122.34,149.66 L96,123.31 L40,179.31 V200 H224 A8,8 0 0 1 232,208 Z" />
                        <ui:ProfessorHexTile AbsoluteLayout.LayoutBounds="159,273,146,168" AccentColor="#009C60" Text="Calendario"
                            IconGeometry="M208,32 H184 V24 A8,8 0 0 0 168,24 V32 H88 V24 A8,8 0 0 0 72,24 V32 H48 A16,16 0 0 0 32,48 V208 A16,16 0 0 0 48,224 H208 A16,16 0 0 0 224,208 V48 A16,16 0 0 0 208,32 Z M72,48 V56 A8,8 0 0 0 88,56 V48 H168 V56 A8,8 0 0 0 184,56 V48 H208 V80 H48 V48 Z M208,208 H48 V96 H208 Z M140,132 A12,12 0 1 1 128,120 A12,12 0 0 1 140,132 Z M184,132 A12,12 0 1 1 172,120 A12,12 0 0 1 184,132 Z M96,172 A12,12 0 1 1 84,160 A12,12 0 0 1 96,172 Z M140,172 A12,12 0 1 1 128,160 A12,12 0 0 1 140,172 Z M184,172 A12,12 0 1 1 172,160 A12,12 0 0 1 184,172 Z" />
                        <ui:ProfessorHexTile AbsoluteLayout.LayoutBounds="318,273,146,168" AccentColor="#15A3DD" Text="Ayuda"
                            IconGeometry="M560,720 C560,746.51 538.51,768 512,768 C485.49,768 464,746.51 464,720 C464,693.49 485.49,672 512,672 C538.51,672 560,693.49 560,720 Z M512,288 C423.76,288 352,352.6 352,432 L352,448 C352,465.67 366.33,480 384,480 C401.67,480 416,465.67 416,448 L416,432 C416,388 459.08,352 512,352 C564.92,352 608,388 608,432 C608,476 564.92,512 512,512 C494.33,512 480,526.33 480,544 L480,576 C480,593.67 494.33,608 512,608 C529.67,608 544,593.67 544,576 L544,573.12 C616.96,559.72 672,501.52 672,432 C672,352.6 600.24,288 512,288 Z M928,512 C928,741.75 741.75,928 512,928 C282.25,928 96,741.75 96,512 C96,282.25 282.25,96 512,96 C741.65,96.25 927.75,282.35 928,512 Z M864,512 C864,317.6 706.4,160 512,160 C317.6,160 160,317.6 160,512 C160,706.4 317.6,864 512,864 C706.31,863.77 863.77,706.31 864,512 Z" />
                    </AbsoluteLayout>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Dock como el del diseño de referencia: píldora oscura con la marca de AVACOM en un círculo blanco y las opciones con el icono
             sobre la etiqueta. Mismos botones, mismas etiquetas y mismas acciones que antes. Los círculos se dibujan con RoundRectangle
             (un Ellipse degenerado en su primer cuadro tumba los lienzos Win2D de la ventana). -->
        <Border Grid.Row="2" Padding="8,4" BackgroundColor="#53544F" HeightRequest="64" HorizontalOptions="Center" StrokeShape="RoundRectangle 32" StrokeThickness="0" VerticalOptions="Center" ZIndex="5">
            <Border.Shadow><Shadow Brush="#35000000" Offset="0,5" Radius="10" /></Border.Shadow>
            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                <Border BackgroundColor="White" HeightRequest="48" Padding="0" StrokeShape="RoundRectangle 24" StrokeThickness="0" WidthRequest="48">
                    <Image HeightRequest="30" Source="avacom_mark.png" WidthRequest="27" />
                </Border>
                <Button Text="Menú" ImageSource="dock_menu.png" ContentLayout="Top,3" Style="{StaticResource DockButton}"/>
                <Button Text="Clase en vivo" ImageSource="dock_live.png" ContentLayout="Top,3" Style="{StaticResource DockButton}" Clicked="OnClaseEnVivo"/>
                <Button Text="Asignaturas" ImageSource="dock_courses.png" ContentLayout="Top,3" Style="{StaticResource DockButton}" Clicked="OnCourses"/>
                <Button Text="Ayuda" ImageSource="dock_help.png" ContentLayout="Top,3" Style="{StaticResource DockButton}"/>
                <Button Text="Salir" ImageSource="dock_logout.png" ContentLayout="Top,3" Style="{StaticResource DockButton}" Clicked="OnLogout"/>
            </HorizontalStackLayout>
        </Border>
    </Grid>
</ContentPage>
