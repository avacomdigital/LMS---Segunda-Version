<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Avacom.Lms.Student.Pages.ConnectionPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:Avacom.Lms.Ui.Controls;assembly=Avacom.Lms.Ui" xmlns:gfx="clr-namespace:Avacom.Lms.Ui.Graphics;assembly=Avacom.Lms.Ui" Shell.NavBarIsVisible="False" SizeChanged="OnPageSizeChanged">
    <!-- Misma composición que el acceso de AVACOM OPS, sobre la cuadrícula de tercios: la tarjeta va centrada en la línea vertical
         del primer tercio (columna 1: de 1/6 a 1/2 del ancho, desplazada 50 px a la izquierda) y el lápiz 3D centrado en la línea
         de 5/6 (columna 3: de 2/3 al borde), cabiendo en el tercio central de alto. A diferencia del acceso de OPS, Student no
         lleva el saludo vertical «BIENVENIDO / WELCOME…»: el canal izquierdo (columna 0) queda libre para el panal. En Y, tarjeta y
         lápiz van de 1/6 a 5/6. Es la composición de una pantalla ancha; en ventanas estrechas o
         en vertical el code-behind (AjustarComposicion) sólo recoloca estas mismas piezas: nada se quita ni cambia de función. -->
    <Grid x:Name="Escena" RowDefinitions="86,*,24">
        <Grid.Background><SolidColorBrush Color="{StaticResource Fondo}"/></Grid.Background>
        <!-- Acceso de tableta con la estructura del Aula · Design System, como el de OPS: fondo Nube con hexágonos de marca (efecto de
             acceso y portadas, 100 % decorativo y sin captar toques), isla de marca compacta arriba al centro y la tarjeta centrada en el
             área segura. El code-behind (AjustarComposicion) sólo ajusta el tamaño de la tarjeta a la ventana. -->
        <GraphicsView x:Name="Panal" Grid.RowSpan="3" InputTransparent="True" HorizontalOptions="Fill" VerticalOptions="Fill">
            <GraphicsView.Drawable>
                <gfx:HexagonosDeMarcaDrawable/>
            </GraphicsView.Drawable>
        </GraphicsView>
        <controls:IslaDeMarca Compacta="True" Grid.Row="0"/>
        <!-- Caja del DS: superficie blanca opaca, contorno completo en Linea, radio 24 y sombra difusa sh-2. Sin vidrio. -->
        <controls:GlassBorder x:Name="Tarjeta" Grid.Row="1" Padding="0" HorizontalOptions="Center" VerticalOptions="Center" StrokeShape="RoundRectangle 32" StrokeThickness="1" TintColor="White" TintOpacity="1" BlurRadius="0" Brightness="0" Saturation="1" Backdrop="False" Stroke="{StaticResource Linea}">
            <controls:GlassBorder.Shadow><Shadow Brush="{StaticResource Tinta}" Opacity="0.13" Offset="0,14" Radius="32"/></controls:GlassBorder.Shadow>
            <Grid>
                <Grid x:Name="Contenido" RowDefinitions="Auto,*">
                    <!-- Arriba de la tarjeta (sólo lo que ocupa): identidad + mensaje. Se apoya sobre la línea divisoria. En los pasos del acceso
                         (grupo, nombre, PIN…) el título y la descripción dicen qué hacer, y «Aviso» dice qué pasó y qué sigue (§5). -->
                    <Grid Grid.Row="0" Padding="40,28,40,14">
                        <VerticalStackLayout x:Name="Cabecera" Spacing="8" VerticalOptions="End">
                            <!-- El SVG lleva aire dentro de su viewBox (≈6% a la izquierda, ≈24% abajo); el margen negativo alinea el dibujo con el texto -->
                            <Image x:Name="Logo" IsVisible="False" Source="avacom_lms_kit_logo.png" Aspect="AspectFit" HeightRequest="100" HorizontalOptions="Start" Margin="-8,0,0,-18"/>
                            <Label x:Name="Titulo" Text="Conéctate a tu aula" FontSize="34" FontFamily="LexendSemiBold" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" AutomationId="acceso-titulo"/>
                            <Label x:Name="Descripcion" Text="Escribe tu nombre y la dirección que aparece en la pantalla principal del profesor." FontSize="17" TextColor="{StaticResource Tinta2}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap"/>
                            <Label x:Name="Aviso" IsVisible="False" FontSize="15" FontFamily="LexendMedium" TextColor="#1F2433" LineBreakMode="WordWrap" MaxLines="3" AutomationId="acceso-aviso"/>
                        </VerticalStackLayout>
                        <!-- Un paso atrás (grupo ← nombre ← PIN), arriba a la izquierda en su propia línea: nunca pisa el título ni el aviso. -->
                        <Button x:Name="VolverButton" IsVisible="False" Text="‹  Volver" HorizontalOptions="Start" VerticalOptions="Start" Margin="-14,-16,0,0" HeightRequest="48" MinimumWidthRequest="104"
                                BackgroundColor="Transparent" BorderWidth="0" TextColor="{StaticResource Azul700}" FontSize="17" Padding="14,0" Clicked="OnVolver" AutomationId="acceso-volver"/>
                    </Grid>
                    <!-- Debajo, todo el resto de la tarjeta: acción (antes la cabecera ocupaba un tercio fijo y el formulario no cabía
                         en ventanas bajas). El ScrollView sólo actúa si el contenido no cabe (ventana baja o teclado en pantalla en la tableta); en una
                         ventana amplia no se nota. Debajo, fuera del desplazamiento, las dos acciones que el acceso del alumno deja
                         SIEMPRE a la vista (RF-20, RN-40): «No estoy en la lista · soy nuevo» y «Entrar como visitante». -->
                    <Grid Grid.Row="1" RowDefinitions="*,Auto">
                    <ScrollView x:Name="PasoScroll" IsVisible="False">
                        <VerticalStackLayout x:Name="PasoHost" Padding="40,0,40,4" Spacing="12" VerticalOptions="Start"/>
                    </ScrollView>
                    <Grid x:Name="Pie" Grid.Row="1" IsVisible="False" ColumnDefinitions="*,*" ColumnSpacing="10" Padding="40,4,40,14">
                        <Button x:Name="NuevoButton" Text="No estoy en la lista · soy nuevo" HeightRequest="52" CornerRadius="26" BackgroundColor="White" TextColor="{StaticResource Tinta}" BorderColor="{StaticResource Linea}" BorderWidth="2"
                                FontSize="13" LineBreakMode="WordWrap" Padding="8,0" Clicked="OnSoyNuevo" AutomationId="acceso-nuevo"/>
                        <Button x:Name="VisitanteButton" Grid.Column="1" Text="Entrar como visitante" HeightRequest="52" CornerRadius="26" BackgroundColor="White" TextColor="{StaticResource Tinta}" BorderColor="{StaticResource Azul100}" BorderWidth="2"
                                FontSize="13" LineBreakMode="WordWrap" Padding="8,0" Clicked="OnVisitante" AutomationId="acceso-visitante"/>
                    </Grid>
                    <ScrollView x:Name="FormularioScroll">
                        <VerticalStackLayout x:Name="Formulario" Padding="40,0,40,16" Spacing="14" VerticalOptions="Start">
                            <BoxView HeightRequest="1" Color="Transparent"/>
                            <!-- Sin sesión obligatoria (prototipo) se escribe el nombre. Cuando el aula pide sesión (007-10) este paso sólo pide la
                                 dirección; quién eres se elige después, en los pasos del acceso del alumno (grupo, nombre y PIN). -->
                            <VerticalStackLayout x:Name="NombreBox" Spacing="6" Margin="0,4,0,0">
                                <Label Text="Tu nombre" FontSize="13"/>
                                <controls:CampoDs><Entry ClassId="neumo" VerticalOptions="Center" x:Name="NameEntry" AutomationId="acceso-nombre" Text="Ethan Martínez" Placeholder="Nombre y apellido"/></controls:CampoDs>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Dirección del aula" FontSize="13"/>
                                <controls:CampoDs><Entry ClassId="neumo" VerticalOptions="Center" x:Name="ServerEntry" AutomationId="acceso-direccion" Text="http://192.168.1.10:8000" Keyboard="Url" Placeholder="192.168.1.10:8000"/></controls:CampoDs>
                            </VerticalStackLayout>
                            <Border x:Name="StatusCard" BackgroundColor="#E3F5FC" Padding="14" StrokeThickness="0" StrokeShape="RoundRectangle 16"><Label x:Name="StatusLabel" Text="●  Lista para comprobar la red local" TextColor="{StaticResource Azul700}"/></Border>
                            <Border Style="{StaticResource NeuButtonShell}" BackgroundColor="{StaticResource Superficie}" Margin="0,4,0,0">
                                <Border.Shadow><Shadow Brush="Transparent" Opacity="0" Offset="0,0" Radius="0"/></Border.Shadow>
                                <Button x:Name="CheckButton" AutomationId="acceso-comprobar" Text="Comprobar conexión" Style="{StaticResource DarkButton}" Clicked="OnCheck"/>
                            </Border>
                            <Border Style="{StaticResource NeuButtonShell}" BackgroundColor="{StaticResource Principal}" Margin="0,4,0,0">
                                <Border.Shadow><Shadow Brush="{StaticResource Principal}" Opacity="0.22" Offset="0,4" Radius="10"/></Border.Shadow>
                                <Button x:Name="EntrarButton" AutomationId="acceso-entrar" Text="Entrar al aula" Style="{StaticResource PrimaryButton}" BorderWidth="0" Clicked="OnEnter"/>
                            </Border>
                            <Label x:Name="NotaDemo" Text="También puedes entrar en modo demo sin conexión." Style="{StaticResource Muted}" HorizontalTextAlignment="Center" FontSize="11" LineBreakMode="WordWrap"/>
                            <!-- MOD-019 §3.6: un ZIP con los logs del aparato, la versión y la configuración no sensible, para entregarlo a soporte. Sin datos personales. -->
                            <Button x:Name="DiagnosticoRedButton" Text="Diagnóstico de red" BackgroundColor="Transparent" TextColor="{StaticResource Azul700}" FontSize="12" HeightRequest="36" Clicked="OnDiagnosticoRed" AutomationId="DiagnosticoDeRed"/>
                            <Button x:Name="DiagnosticoButton" Text="Exportar diagnóstico" BackgroundColor="Transparent" TextColor="{StaticResource Azul700}" FontSize="12" HeightRequest="36" Clicked="OnDiagnostico" AutomationId="ExportarDiagnostico"/>
                        </VerticalStackLayout>
                    </ScrollView>
                    </Grid>
                </Grid>
            </Grid>
        </controls:GlassBorder>
        <!-- Lápiz 3D decorativo (render nativo en un GraphicsView transparente): gira despacio sobre su eje vertical, inclinado
             8°, flotando apenas. Centrado en la línea de 5/6; con FillRatio 0,53 cabe en el tercio central de alto. Sólo se ve
             el lápiz; el fondo sigue debajo y la capa no captura toques. -->
        <controls:Pencil3DView x:Name="Lapiz" IsVisible="False" Grid.Row="1" InputTransparent="True" HorizontalOptions="Fill" VerticalOptions="Fill" SecondsPerTurn="12" TiltDegrees="8" FloatPixels="3" FillRatio="0.53"/>
    </Grid>
</ContentPage>
