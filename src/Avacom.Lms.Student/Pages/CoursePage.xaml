<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Avacom.Lms.Student.Pages.CoursePage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ui="clr-namespace:Avacom.Lms.Ui.Controls;assembly=Avacom.Lms.Ui" Shell.NavBarIsVisible="False">
    <!-- Estructura del Aula · Design System: isla de marca, fecha y hora y etiqueta de modo de la tableta y fondo Aurora; la raíz de la pantalla va debajo, sin cambios. -->
    <ui:MarcoDs Tableta="True" Modo="Aprender">
    <Grid RowDefinitions="68,*"><Grid BackgroundColor="Transparent" Padding="48,0" ColumnDefinitions="Auto,*,Auto"><Button Text="←  Menú" BackgroundColor="#FFFFFF" TextColor="#1F2433" BorderColor="#E3E6EC" BorderWidth="2" CornerRadius="24" FontSize="16" FontFamily="LexendMedium" HeightRequest="48" Padding="18,0" VerticalOptions="Center" Clicked="OnBack"/><Label Grid.Column="1" Text="Asignatura" FontSize="18" FontFamily="LexendSemiBold" HorizontalOptions="Center" VerticalOptions="Center"/><Border Grid.Column="2" BackgroundColor="#FDE7E7" Padding="12,7" StrokeThickness="0" VerticalOptions="Center"><Label Text="62% completado" TextColor="{StaticResource Verde700}" FontFamily="LexendSemiBold"/></Border></Grid>
        <ScrollView Grid.Row="1"><VerticalStackLayout Padding="24,26,24,90" Spacing="20" MaximumWidthRequest="980" HorizontalOptions="Center">
            <Border Padding="26"><Grid ColumnDefinitions="90,*" ColumnSpacing="20"><Border BackgroundColor="#FDE7E7" WidthRequest="82" HeightRequest="82" StrokeThickness="0"><Label Text="∑" FontSize="38" TextColor="{StaticResource BrandRed}" FontFamily="LexendSemiBold" HorizontalOptions="Center" VerticalOptions="Center"/></Border><VerticalStackLayout Grid.Column="1" VerticalOptions="Center"><Label Text="Álgebra Octavo B" Style="{StaticResource PageTitle}"/><Label Text="Matemáticas · 8° B · Prof. Elena Castillo" Style="{StaticResource Muted}"/><ProgressBar Progress="0.62" ProgressColor="{StaticResource Principal}" Margin="0,10,0,0"/></VerticalStackLayout></Grid></Border>
            <Label Text="Tu ruta de aprendizaje" FontSize="22" FontFamily="LexendSemiBold"/>
            <Border Padding="22"><VerticalStackLayout Spacing="15"><Grid ColumnDefinitions="48,*"><Border BackgroundColor="{StaticResource Magenta600}" WidthRequest="38" HeightRequest="38" StrokeThickness="0"><Label Text="✓" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/></Border><VerticalStackLayout Grid.Column="1"><Label Text="Unidad 1 · Lenguaje algebraico" FontSize="18" FontFamily="LexendSemiBold"/><Label Text="Lección 1 · Expresiones algebraicas" Style="{StaticResource Muted}"/></VerticalStackLayout></Grid><BoxView HeightRequest="1" Color="Transparent"/><Label Text="✓ Variables y constantes"/><Label Text="✓ Construye una expresión"/></VerticalStackLayout></Border>
            <Border Padding="22"><VerticalStackLayout Spacing="15"><Grid ColumnDefinitions="48,*"><Border BackgroundColor="{StaticResource BrandYellow}" WidthRequest="38" HeightRequest="38" StrokeThickness="0"><Label Text="2" TextColor="#9A3412" FontFamily="LexendSemiBold" HorizontalOptions="Center" VerticalOptions="Center"/></Border><VerticalStackLayout Grid.Column="1"><Label Text="Unidad 2 · Ecuaciones lineales" FontSize="18" FontFamily="LexendSemiBold"/><Label Text="Lección 2 · Igualdades y equivalencias" Style="{StaticResource Muted}"/></VerticalStackLayout></Grid><BoxView HeightRequest="1" Color="Transparent"/><Label Text="✓ La balanza algebraica · Video"/><Label Text="○ Resuelve paso a paso · Práctica"/></VerticalStackLayout></Border>
            <Border Padding="22"><VerticalStackLayout Spacing="15"><Grid ColumnDefinitions="48,*"><Border BackgroundColor="{StaticResource BrandBlue}" WidthRequest="38" HeightRequest="38" StrokeThickness="0"><Label Text="3" TextColor="White" FontFamily="LexendSemiBold" HorizontalOptions="Center" VerticalOptions="Center"/></Border><VerticalStackLayout Grid.Column="1"><Label Text="Unidad 3 · Aplicaciones y reto final" FontSize="18" FontFamily="LexendSemiBold"/><Label Text="Lección 3 · Modelación y evaluación" Style="{StaticResource Muted}"/></VerticalStackLayout></Grid><BoxView HeightRequest="1" Color="Transparent"/><Label Text="○ Problemas de contexto · Taller"/><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Quiz: Conociendo México" FontFamily="LexendSemiBold"/><Label Text="Actividad final · 5 preguntas" Style="{StaticResource Muted}"/></VerticalStackLayout><Button Grid.Column="1" Text="Comenzar quiz" Style="{StaticResource PrimaryButton}" WidthRequest="160" Clicked="OnQuiz"/></Grid></VerticalStackLayout></Border>
        </VerticalStackLayout></ScrollView>
    </Grid>
    </ui:MarcoDs>
</ContentPage>
